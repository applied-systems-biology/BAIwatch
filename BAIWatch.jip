        "jipipe:metadata-v1" : {
          "location/_/y" : 84,
          "location/999c9b80-1dfc-453a-b7c1-d9fabe699cfb/x" : 13,
          "location/_/x" : 16,
          "location/999c9b80-1dfc-453a-b7c1-d9fabe699cfb/y" : 79
        },
        "jipipe:node-info-id" : "cpython-script-iterating",
        "annotation-merge-strategy" : "Merge",
        "jipipe:algorithm:enabled" : true,
        "jipipe:node:ui-locked" : false,
        "code" : {
          "code" : "from jipipe.imagej import *\nimport numpy as np\nfrom skimage.transform import resize\nimport cv2\n\n\n\nds = jipipe_inputs[\"Input\"]\nstack_in = load_image_file(data_slot=ds, row=0)\nstack_in = np.asarray(stack_in)\n\n\nSCAN_MODE = jipipe_annotations[\"TileScanOrder\"]\nTARGET_WIDTH = 4000\n\nscale = float(jipipe_annotations[\"Scale\"])\nprint(\"Scale;\",scale)\n\nif scale != 1:\n    stack_in = np.stack([cv2.resize(tile, (0, 0), fx=scale, fy=scale, interpolation=cv2.INTER_NEAREST) for tile in stack_in])\n        \t\t\n        \t\t\nprint(\"Input shape:\", stack_in.shape)\n\ntotal_rows = int(jipipe_annotations[\"TilesX\"])\ntotal_cols = int(jipipe_annotations[\"TilesY\"])\n\nprint(\"TilesX / rows:\", total_rows)\nprint(\"TilesY / columns:\", total_cols)\n\nif stack_in.ndim not in (3, 4): raise RuntimeError(f\"Expected (N,H,W) or (N,H,W,C), got {stack_in.shape}\")\n\nnumber_of_tiles = stack_in.shape[0]\nexpected_number_of_tiles = total_rows * total_cols\n\nprint(\"Number of tiles:\", number_of_tiles)\nprint(\"Expected number of tiles:\", expected_number_of_tiles)\n\nif number_of_tiles != expected_number_of_tiles: raise RuntimeError(f\"Tile count does not match TilesX × TilesY. TilesX={total_rows}, TilesY={total_cols}, expected={expected_number_of_tiles}, actual={number_of_tiles}\")\n\ngrid = stack_in.reshape((total_rows, total_cols) + stack_in.shape[1:])\n\nprint(\"Grid shape:\", grid.shape)\n\nif SCAN_MODE == \"Serpentine\": grid[1::2] = grid[1::2, ::-1]\nelif SCAN_MODE == \"Raster\": pass\nelse: raise ValueError(\"SCAN_MODE must be 'Serpentine' or 'Raster'.\")\n\nstack_out = grid.reshape(stack_in.shape)\n\nprint(\"Reordered stack shape:\", stack_out.shape)\n\ntile_h_new = stack_out.shape[1]\ntile_w_new = stack_out.shape[2]\n\nprint(\"Tile dimensions:\", tile_w_new, \"x\", tile_h_new)\n\ngrid_width = total_cols * tile_w_new\ngrid_height = total_rows * tile_h_new\n\nprint(\"Grid width:\", grid_width)\nprint(\"Grid height:\", grid_height)\n\nscale = TARGET_WIDTH / grid_width\nnew_tile_w = max(1, int(round(tile_w_new * scale)))\nnew_tile_h = max(1, int(round(tile_h_new * scale)))\n\nprint(\"Scale:\", scale)\nprint(\"Original tile:\", tile_w_new, \"x\", tile_h_new)\nprint(\"Resized tile:\", new_tile_w, \"x\", new_tile_h)\n\nscaled_grid_width = total_cols * new_tile_w\nscaled_grid_height = total_rows * new_tile_h\n\nprint(\"Downscaled grid:\", scaled_grid_width, \"x\", scaled_grid_height)\n\nresized_tiles = np.stack([resize(tile, (new_tile_h, new_tile_w), preserve_range=True, anti_aliasing=True) if tile.ndim == 2 else resize(tile, (new_tile_h, new_tile_w, tile.shape[2]), preserve_range=True, anti_aliasing=True) for tile in stack_out]).astype(stack_out.dtype)\n\nexpected_resized_shape = (expected_number_of_tiles, new_tile_h, new_tile_w) if stack_out.ndim == 3 else (expected_number_of_tiles, new_tile_h, new_tile_w, stack_out.shape[3])\n\nif resized_tiles.shape != expected_resized_shape: raise RuntimeError(f\"Unexpected resized stack dimensions. Expected={expected_resized_shape}, actual={resized_tiles.shape}\")\n\nprint(\"Resized stack shape:\", resized_tiles.shape)\n\n\n# Remove overlap from the right and bottom of each tile.\noverlap_x = float(jipipe_annotations[\"OverlapX\"])\noverlap_y = float(jipipe_annotations[\"OverlapY\"])\n\ntile_height, tile_width = stack_in.shape[1:3]\n\ncrop_width = int(round(tile_width * (1 - overlap_x / 100)))\ncrop_height = int(round(tile_height * (1 - overlap_y / 100)))\n\n# Grid dimensions after overlap removal (TilesX = rows, TilesY = columns).\ngrid_width_croped = int(float(jipipe_annotations[\"TilesY\"])) * crop_width\ngrid_height_croped = int(float(jipipe_annotations[\"TilesX\"])) * crop_height\n\n\n\nannotations = {\"TilesX\": str(total_rows), \n\"TilesY\": str(total_cols), \n\"NbTilesX\": str(total_rows), \n\"NbTilesY\": str(total_cols),  \n\"tile_w_new\": str(tile_w_new), \n\"tile_h_new\": str(tile_h_new), \n\"grid_width\": str(grid_width), \n\"grid_height\": str(grid_height), \n\"grid_width_croped\": str(grid_width_croped), \n\"grid_height_croped\": str(grid_height_croped), \n\"DownscaledTileWidth\": str(new_tile_w), \n\"DownscaledTileHeight\": str(new_tile_h), \n\"ScaledGridWidth\": str(scaled_grid_width), \n\"ScaledGridHeight\": str(scaled_grid_height), \n\"TargetMontageWidth\": str(TARGET_WIDTH), \n#\"Scale\": str(scale), \n\"NumberOfTiles\": str(number_of_tiles)}\n\ndso = jipipe_outputs[\"Output\"]\nadd_image(stack_out, dso, text_annotations=annotations)\n\ndso = jipipe_outputs[\"Output 1\"]\nadd_image(resized_tiles, dso, text_annotations=annotations)",
          "collapsed" : false
        },
