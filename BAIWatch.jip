      "519fc489-3ecc-4f0b-9bf4-9196222bfc33" : {
        "jipipe:graph-compartment" : "999c9b80-1dfc-453a-b7c1-d9fabe699cfb",
        "jipipe:alias-id" : "bio-formats-importer",
        "jipipe:slot-configuration" : {
          "input" : {
            "Input" : {
              "slot-data-type" : "imagej-imgplus",
              "slot-type" : "Input",
              "name" : "Input",
              "custom-name" : null,
              "description" : "",
              "is-virtual" : false,
              "save-outputs" : true,
              "is-optional" : false
            }
          },
          "output" : {
            "Output" : {
              "slot-data-type" : "imagej-imgplus",
              "slot-type" : "Output",
              "name" : "Output",
              "custom-name" : null,
              "description" : "",
              "is-virtual" : true,
              "save-outputs" : true,
              "is-optional" : false
            },
            "Results" : {
              "slot-data-type" : "imagej-results-table",
              "slot-type" : "Output",
              "name" : "Results",
              "custom-name" : null,
              "description" : "",
              "is-virtual" : false,
              "save-outputs" : true,
              "is-optional" : false
            }
          }
        },
        "jipipe:metadata-v1" : {
          "location/_/y" : 65,
          "location/999c9b80-1dfc-453a-b7c1-d9fabe699cfb/x" : 1,
          "location/_/x" : 5,
          "location/999c9b80-1dfc-453a-b7c1-d9fabe699cfb/y" : 72
        },
        "jipipe:node-info-id" : "external-imagej-macro",
        "export-delay" : 250,
        "jipipe:algorithm:enabled" : true,
        "jipipe:node:ui-locked" : false,
        "code" : {
          "code" : "selectWindow(\"Input\");\n\ninputFile = getJIPipeAnnotation(\"#FullPath\");\n\nselectedC = parseInt(getJIPipeAnnotation(\"C\"));\nselectedZ = parseInt(getJIPipeAnnotation(\"Z\"));\nselectedT = parseInt(getJIPipeAnnotation(\"T\"));\n\nstackOrder = getJIPipeAnnotation(\"StackOrder\");\n\ntileWidth = parseInt(getJIPipeAnnotation(\"TileWidth\"));\ntileHeight = parseInt(getJIPipeAnnotation(\"TileHeight\"));\n\nmaxPixelsPerCrop = parseInt(getJIPipeAnnotation(\"MaxBlockPixels\"));\n\noutputName = \"Output\";\n\nrun(\"Bio-Formats Macro Extensions\");\n\nExt.setId(inputFile);\n\nExt.getSizeX(sizeX);\nExt.getSizeY(sizeY);\nExt.getSizeC(sizeC);\nExt.getSizeZ(sizeZ);\nExt.getSizeT(sizeT);\n\nExt.close();\n\n\n// ------------------------------------------------------------\n// Tile calculations\n// ------------------------------------------------------------\n\nfullTileCols = floor(sizeX / tileWidth);\nfullTileRows = floor(sizeY / tileHeight);\n\nremainderX = sizeX - fullTileCols * tileWidth;\nremainderY = sizeY - fullTileRows * tileHeight;\n\ncoverTileCols = fullTileCols;\ncoverTileRows = fullTileRows;\n\nif (remainderX > 0) {\n    coverTileCols = coverTileCols + 1;\n}\n\nif (remainderY > 0) {\n    coverTileRows = coverTileRows + 1;\n}\n\n\n// ------------------------------------------------------------\n// Print everything\n// ------------------------------------------------------------\n\nprint(\"====================================\");\nprint(\"RAW PARAMETERS\");\nprint(\"====================================\");\n\nprint(\"inputFile = \" + inputFile);\n\nprint(\"selectedC = \" + selectedC);\nprint(\"selectedZ = \" + selectedZ);\nprint(\"selectedT = \" + selectedT);\n\nprint(\"stackOrder = \" + stackOrder);\n\nprint(\"tileWidth = \" + tileWidth);\nprint(\"tileHeight = \" + tileHeight);\n\nprint(\"maxPixelsPerCrop = \" + maxPixelsPerCrop);\n\n\nprint(\"\");\nprint(\"====================================\");\nprint(\"IMAGE SIZE\");\nprint(\"====================================\");\n\nprint(\"sizeX = \" + sizeX);\nprint(\"sizeY = \" + sizeY);\n\nprint(\"sizeC = \" + sizeC);\nprint(\"sizeZ = \" + sizeZ);\nprint(\"sizeT = \" + sizeT);\n\n\nprint(\"\");\nprint(\"====================================\");\nprint(\"FULL TILE COUNT\");\nprint(\"====================================\");\n\nprint(\"fullTileCols = \" + fullTileCols);\nprint(\"fullTileRows = \" + fullTileRows);\n\n\nprint(\"\");\nprint(\"====================================\");\nprint(\"REMAINDER\");\nprint(\"====================================\");\n\nprint(\"remainderX = \" + remainderX);\nprint(\"remainderY = \" + remainderY);\n\n\nprint(\"\");\nprint(\"====================================\");\nprint(\"COVERAGE TILE COUNT\");\nprint(\"====================================\");\n\nprint(\"coverTileCols = \" + coverTileCols);\nprint(\"coverTileRows = \" + coverTileRows);\n\n\nprint(\"\");\nprint(\"====================================\");\nprint(\"RECONSTRUCTED DIMENSIONS\");\nprint(\"====================================\");\n\nprint(\"full tiles width = \" + fullTileCols * tileWidth);\nprint(\"full tiles height = \" + fullTileRows * tileHeight);\n\nprint(\"coverage width = \" + coverTileCols * tileWidth);\nprint(\"coverage height = \" + coverTileRows * tileHeight);\n\n\n// ============================================================\n// ESTIMATE MICROSCOPE TILE GRID\n// ============================================================\n\ntotalTileCols = round(sizeX / tileWidth);\ntotalTileRows = round(sizeY / tileHeight);\n\nprint(\"sizeX = \" + sizeX);\nprint(\"sizeY = \" + sizeY);\n\nprint(\"tileWidth = \" + tileWidth);\nprint(\"tileHeight = \" + tileHeight);\n\nprint(\"sizeX / tileWidth = \" + (sizeX / tileWidth));\nprint(\"sizeY / tileHeight = \" + (sizeY / tileHeight));\n\nprint(\"totalTileCols = \" + totalTileCols);\nprint(\"totalTileRows = \" + totalTileRows);\n\n\n\ntotalPixels = sizeX * sizeY;\n\nisSmall = totalPixels <= maxPixelsPerCrop;\nisLarge = totalPixels > maxPixelsPerCrop;\n\n\n\nif (isSmall) {\n\trun(\"Bio-Formats Importer\", \n\t    \"open=[\" + inputFile + \"] \" +\n        \" autoscale\" +\n            \" color_mode=Default\" +\n            \" crop rois_import=[ROI manager]\" +\n            \" specify_range\" +\n            \" view=Hyperstack\" +\n            \" stack_order=\"+stackOrder+\" c_begin=\" + selectedC + \" c_end=\" + selectedC + \" c_step=1\" +\n            \"  z_begin=\" + selectedZ + \" z_end=\" + selectedZ + \" z_step=1\" +\n            \"  t_begin=\" + selectedT + \" t_end=\" + selectedT + \" t_step=1\" +\n            \" x_coordinate_1=0 y_coordinate_1=0 width_1=\" +sizeX + \" height_1=\" +sizeY+ \" \");\n     \n     getDimensions(width, height, channels, slices, frames);\n\n    if (channels != 1 || slices != 1 || frames != 1) {\n        exit(\"ERROR: Imported image must have C=1, Z=1, T=1. Current dimensions: C=\" + channels + \", Z=\" + slices + \", T=\" + frames);\n    }\n    rename(\"Montage\");\n    run(\"Montage to Stack...\", \"columns=\" + totalTileCols + \" rows=\" + totalTileRows + \" border=0\");\n    rename(\"Output\");\n    selectWindow(\"Montage\");\n    close();\n    \n}            \n// ============================================================\n// LARGE IMAGE\n// ============================================================\nif (isLarge) {\n\n    print(\"\");\n    print(\"========================================\");\n    print(\"LARGE IMAGE MODE\");\n    print(\"========================================\");\n\n    print(\"sizeX = \" + sizeX);\n    print(\"sizeY = \" + sizeY);\n    print(\"tileWidth = \" + tileWidth);\n    print(\"tileHeight = \" + tileHeight);\n    print(\"totalTileCols = \" + totalTileCols);\n    print(\"totalTileRows = \" + totalTileRows);\n    print(\"maxPixelsPerCrop = \" + maxPixelsPerCrop);\n\n\n    // --------------------------------------------------------\n    // Pixels per microscope tile\n    // --------------------------------------------------------\n\n    pixelsPerTile = tileWidth * tileHeight;\n\n    print(\"\");\n    print(\"----------------------------------------\");\n    print(\"PIXELS PER TILE\");\n    print(\"----------------------------------------\");\n\n    print(\"pixelsPerTile = \" + pixelsPerTile);\n\n\n    // --------------------------------------------------------\n    // Maximum number of microscope tiles that can fit\n    // --------------------------------------------------------\n\n    maxTilesPerBlock = floor(maxPixelsPerCrop / pixelsPerTile);\n\n    print(\"\");\n    print(\"----------------------------------------\");\n    print(\"MAXIMUM TILES PER BLOCK\");\n    print(\"----------------------------------------\");\n\n    print(\"maxTilesPerBlock = \" + maxTilesPerBlock);\n\n\n    // --------------------------------------------------------\n    // Choose approximately square block dimensions\n    // --------------------------------------------------------\n\n    maxBlockTileCols = floor(sqrt(maxTilesPerBlock));\n\n    print(\"\");\n    print(\"----------------------------------------\");\n    print(\"INITIAL BLOCK SHAPE\");\n    print(\"----------------------------------------\");\n\n    print(\"Initial maxBlockTileCols = \" + maxBlockTileCols);\n\n    if (maxBlockTileCols < 1) {\n        maxBlockTileCols = 1;\n        print(\"maxBlockTileCols corrected to 1\");\n    }\n\n    if (maxBlockTileCols > totalTileCols) {\n        maxBlockTileCols = totalTileCols;\n        print(\"maxBlockTileCols limited to totalTileCols = \" + maxBlockTileCols);\n    }\n\n\n    // --------------------------------------------------------\n    // Recalculate rows after limiting columns\n    // --------------------------------------------------------\n\n    maxBlockTileRows = floor(maxTilesPerBlock / maxBlockTileCols);\n\n    print(\"Initial maxBlockTileRows = \" + maxBlockTileRows);\n\n    if (maxBlockTileRows < 1) {\n        maxBlockTileRows = 1;\n        print(\"maxBlockTileRows corrected to 1\");\n    }\n\n    if (maxBlockTileRows > totalTileRows) {\n        maxBlockTileRows = totalTileRows;\n        print(\"maxBlockTileRows limited to totalTileRows = \" + maxBlockTileRows);\n    }\n\n\n    // --------------------------------------------------------\n    // Standard block dimensions\n    // --------------------------------------------------------\n\n    blockWidth = maxBlockTileCols * tileWidth;\n    blockHeight = maxBlockTileRows * tileHeight;\n\n    blockPixels = blockWidth * blockHeight;\n\n    print(\"\");\n    print(\"----------------------------------------\");\n    print(\"FINAL BLOCK CONFIGURATION\");\n    print(\"----------------------------------------\");\n\n    print(\"maxBlockTileCols = \" + maxBlockTileCols);\n    print(\"maxBlockTileRows = \" + maxBlockTileRows);\n\n    print(\"blockWidth = \" + blockWidth);\n    print(\"blockHeight = \" + blockHeight);\n\n    print(\"blockPixels = \" + blockPixels);\n\n    print(\"blockPixels / maxPixelsPerCrop = \" + (blockPixels / maxPixelsPerCrop));\n\n\n    // --------------------------------------------------------\n    // Initialize\n    // --------------------------------------------------------\n\n    blockIndex = 0;\n    stackCreated = false;\n\n    print(\"\");\n    print(\"----------------------------------------\");\n    print(\"STARTING BLOCK IMPORT\");\n    print(\"----------------------------------------\");\n\n\n    // --------------------------------------------------------\n    // Import blocks\n    // --------------------------------------------------------\n\n    for (startRow = 0; startRow < totalTileRows; startRow += maxBlockTileRows) {\n\n        print(\"\");\n        print(\"========================================\");\n        print(\"START ROW = \" + startRow);\n        print(\"========================================\");\n\n        for (startCol = 0; startCol < totalTileCols; startCol += maxBlockTileCols) {\n\n            print(\"\");\n            print(\"----------------------------------------\");\n            print(\"NEW BLOCK\");\n            print(\"----------------------------------------\");\n\n            print(\"startRow = \" + startRow);\n            print(\"startCol = \" + startCol);\n\n            blockTileCols = maxBlockTileCols;\n            blockTileRows = maxBlockTileRows;\n\n            print(\"Initial blockTileCols = \" + blockTileCols);\n            print(\"Initial blockTileRows = \" + blockTileRows);\n\n\n            // Right edge\n\n            if (startCol + blockTileCols > totalTileCols) {\n                blockTileCols = totalTileCols - startCol;\n                print(\"Right edge detected\");\n                print(\"Adjusted blockTileCols = \" + blockTileCols);\n            }\n\n\n            // Bottom edge\n\n            if (startRow + blockTileRows > totalTileRows) {\n                blockTileRows = totalTileRows - startRow;\n                print(\"Bottom edge detected\");\n                print(\"Adjusted blockTileRows = \" + blockTileRows);\n            }\n\n\n            // Pixel origin\n\n            x = startCol * tileWidth;\n            y = startRow * tileHeight;\n\n            print(\"x = \" + x);\n            print(\"y = \" + y);\n\n\n            // Requested crop size\n\n            requestedCropWidth = blockTileCols * tileWidth;\n            requestedCropHeight = blockTileRows * tileHeight;\n\n            print(\"requestedCropWidth = \" + requestedCropWidth);\n            print(\"requestedCropHeight = \" + requestedCropHeight);\n\n\n            // Remaining real image\n\n            remainingWidth = sizeX - x;\n            remainingHeight = sizeY - y;\n\n            print(\"remainingWidth = \" + remainingWidth);\n            print(\"remainingHeight = \" + remainingHeight);\n\n\n            // Crop width\n\n            cropWidth = requestedCropWidth;\n\n            if (cropWidth > remainingWidth) {\n                cropWidth = remainingWidth;\n                print(\"Crop width clipped to real image\");\n            }\n\n\n            // Crop height\n\n            cropHeight = requestedCropHeight;\n\n            if (cropHeight > remainingHeight) {\n                cropHeight = remainingHeight;\n                print(\"Crop height clipped to real image\");\n            }\n\n\n            print(\"FINAL cropWidth = \" + cropWidth);\n            print(\"FINAL cropHeight = \" + cropHeight);\n\n            currentCropPixels = cropWidth * cropHeight;\n\n            print(\"currentCropPixels = \" + currentCropPixels);\n            print(\"currentCropPixels / maxPixelsPerCrop = \" + (currentCropPixels / maxPixelsPerCrop));\n\n\n            // Block number\n\n            blockIndex++;\n\n            print(\"blockIndex = \" + blockIndex);\n\n\n            // ====================================================\n            // BIO-FORMATS IMPORT\n            // ====================================================\n\n            print(\"\");\n            print(\"BIO-FORMATS IMPORT PARAMETERS\");\n\n            print(\"inputFile = \" + inputFile);\n\n            print(\"selectedC = \" + selectedC);\n            print(\"selectedZ = \" + selectedZ);\n            print(\"selectedT = \" + selectedT);\n\n            print(\"x = \" + x);\n            print(\"y = \" + y);\n\n            print(\"cropWidth = \" + cropWidth);\n            print(\"cropHeight = \" + cropHeight);\n\n\n            run(\n                \"Bio-Formats Importer\",\n                \"open=[\" + inputFile + \"] \" +\n                \" autoscale\" +\n                \" color_mode=Default\" +\n                \" crop rois_import=[ROI manager]\" +\n                \" specify_range\" +\n                \" view=Hyperstack\" +\n                \" stack_order=\"+stackOrder+\" c_begin=\" + selectedC + \" c_end=\" + selectedC + \" c_step=1\" +\n                \" z_begin=\" + selectedZ + \" z_end=\" + selectedZ + \" z_step=1\" +\n                \" t_begin=\" + selectedT + \" t_end=\" + selectedT + \" t_step=1\" +\n                \" x_coordinate_1=\" + x +\n                \" y_coordinate_1=\" + y +\n                \" width_1=\" + cropWidth +\n                \" height_1=\" + cropHeight + \" \"\n            );\n\n\n            // ====================================================\n            // MEASURE WHAT BIO-FORMATS ACTUALLY IMPORTED\n            // ====================================================\n\n            getDimensions(importedWidth, importedHeight, importedChannels, importedSlices, importedFrames);\n\n            print(\"\");\n            print(\"BIO-FORMATS RESULT\");\n\n            print(\"importedWidth = \" + importedWidth);\n            print(\"importedHeight = \" + importedHeight);\n\n            print(\"importedChannels = \" + importedChannels);\n            print(\"importedSlices = \" + importedSlices);\n            print(\"importedFrames = \" + importedFrames);\n\n\n            // ====================================================\n            // TEMPORARY BLOCK NAME\n            // ====================================================\n\n            blockName = \"current_block_\" + blockIndex;\n\n            rename(blockName);\n\n            print(\"blockName = \" + blockName);\n\n\n            // ====================================================\n            // PAD BORDER BLOCKS\n            // ====================================================\n\n            print(\"\");\n            print(\"PADDING CHECK\");\n\n            print(\"cropWidth = \" + cropWidth);\n            print(\"blockWidth = \" + blockWidth);\n\n            print(\"cropHeight = \" + cropHeight);\n            print(\"blockHeight = \" + blockHeight);\n\n            if (cropWidth != blockWidth || cropHeight != blockHeight) {\n\n                print(\"Padding block\");\n\n                run(\n                    \"Canvas Size...\",\n                    \"width=\" + blockWidth +\n                    \" height=\" + blockHeight +\n                    \" position=Top-Left zero\"\n                );\n\n                print(\"After padding:\");\n\n                print(\"getWidth() = \" + getWidth());\n                print(\"getHeight() = \" + getHeight());\n\n            } else {\n\n                print(\"No padding required\");\n            }\n\n\n            // ====================================================\n            // BUILD OUTPUT STACK\n            // ====================================================\n\n            print(\"\");\n            print(\"STACK BUILDING\");\n\n            print(\"stackCreated = \" + stackCreated);\n\n            if (!stackCreated) {\n\n                print(\"First block -> rename to Output\");\n\n                rename(\"Output\");\n\n                stackCreated = true;\n\n                print(\"Output created\");\n                print(\"Current nSlices = \" + nSlices);\n\n            } else {\n\n                print(\"Appending block to Output\");\n\n                selectWindow(blockName);\n\n                print(\"Selected current block\");\n\n                run(\"Select All\");\n                run(\"Copy\");\n\n                print(\"Block copied\");\n\n                selectWindow(\"Output\");\n\n                print(\"Selected Output\");\n                print(\"Output nSlices before add = \" + nSlices);\n\n                setSlice(nSlices);\n                run(\"Add Slice\");\n                setSlice(nSlices);\n\n                print(\"Output nSlices after add = \" + nSlices);\n\n                run(\"Paste\");\n\n                print(\"Block pasted\");\n\n                selectWindow(blockName);\n                close();\n\n                print(\"Temporary block closed\");\n            }\n        }\n\n        print(\"\");\n        print(\"FINISHED startRow = \" + startRow);\n\n        // NOTE:\n        // This stops after the first row of blocks.\n        // Remove it when debugging is finished if you want all rows.\n        // break;\n    }\n\n\n    print(\"\");\n    print(\"========================================\");\n    print(\"LARGE IMAGE LOOP FINISHED\");\n    print(\"========================================\");\n\n    print(\"Total blocks processed = \" + blockIndex);\n    print(\"stackCreated = \" + stackCreated);\n\n    if (stackCreated) {\n        selectWindow(\"Output\");\n        print(\"Final Output width = \" + getWidth());\n        print(\"Final Output height = \" + getHeight());\n        print(\"Final Output nSlices = \" + nSlices);\n    }\n}\n\n// ============================================================\n// RESULTS TABLE\n// ============================================================\n\nrow = nResults;\n\nsetResult(\"inputFile\", row, inputFile);\n\n\n\nsetResult(\"selectedC\", row, selectedC);\nsetResult(\"selectedZ\", row, selectedZ);\nsetResult(\"selectedT\", row, selectedT);\n\nsetResult(\"stackOrder\", row, stackOrder);\n\nsetResult(\"tileWidth\", row, tileWidth);\nsetResult(\"tileHeight\", row, tileHeight);\nsetResult(\"maxPixelsPerCrop\", row, maxPixelsPerCrop);\n\n\n// ============================================================\n// ORIGINAL IMAGE\n// ============================================================\n\nsetResult(\"sizeX\", row, sizeX);\nsetResult(\"sizeY\", row, sizeY);\nsetResult(\"sizeC\", row, sizeC);\nsetResult(\"sizeZ\", row, sizeZ);\nsetResult(\"sizeT\", row, sizeT);\n\nsetResult(\"totalPixels\", row, totalPixels);\n\nsetResult(\"isSmall\", row, isSmall);\nsetResult(\"isLarge\", row, isLarge);\n\n\n// ============================================================\n// TILE GRID CALCULATIONS\n// ============================================================\n\nsetResult(\"fullTileCols\", row, fullTileCols);\nsetResult(\"fullTileRows\", row, fullTileRows);\n\nsetResult(\"remainderX\", row, remainderX);\nsetResult(\"remainderY\", row, remainderY);\n\nsetResult(\"coverTileCols\", row, coverTileCols);\nsetResult(\"coverTileRows\", row, coverTileRows);\n\nsetResult(\"totalTileCols\", row, totalTileCols);\nsetResult(\"totalTileRows\", row, totalTileRows);\n\nsetResult(\"sizeX/tileWidth\", row, sizeX / tileWidth);\nsetResult(\"sizeY/tileHeight\", row, sizeY / tileHeight);\n\nsetResult(\"fullTilesWidth\", row, fullTileCols * tileWidth);\nsetResult(\"fullTilesHeight\", row, fullTileRows * tileHeight);\n\nsetResult(\"coverageWidth\", row, coverTileCols * tileWidth);\nsetResult(\"coverageHeight\", row, coverTileRows * tileHeight);\n\n\n// ============================================================\n// LARGE IMAGE VARIABLES\n// ============================================================\n\nif (isLarge) {\n\n    setResult(\"pixelsPerTile\", row, pixelsPerTile);\n    setResult(\"maxTilesPerBlock\", row, maxTilesPerBlock);\n\n    setResult(\"maxBlockTileCols\", row, maxBlockTileCols);\n    setResult(\"maxBlockTileRows\", row, maxBlockTileRows);\n\n    setResult(\"blockWidth\", row, blockWidth);\n    setResult(\"blockHeight\", row, blockHeight);\n    setResult(\"blockPixels\", row, blockPixels);\n\n    setResult(\"blockPixelRatio\", row, blockPixels / maxPixelsPerCrop);\n\n    setResult(\"blockIndex\", row, blockIndex);\n    setResult(\"stackCreated\", row, stackCreated);\n\n    setResult(\"startRow_last\", row, startRow);\n    setResult(\"startCol_last\", row, startCol);\n\n    setResult(\"blockTileCols_last\", row, blockTileCols);\n    setResult(\"blockTileRows_last\", row, blockTileRows);\n\n    setResult(\"x_last\", row, x);\n    setResult(\"y_last\", row, y);\n\n    setResult(\"requestedCropWidth_last\", row, requestedCropWidth);\n    setResult(\"requestedCropHeight_last\", row, requestedCropHeight);\n\n    setResult(\"remainingWidth_last\", row, remainingWidth);\n    setResult(\"remainingHeight_last\", row, remainingHeight);\n\n    setResult(\"cropWidth_last\", row, cropWidth);\n    setResult(\"cropHeight_last\", row, cropHeight);\n\n    setResult(\"currentCropPixels_last\", row, currentCropPixels);\n\n    setResult(\"importedWidth_last\", row, importedWidth);\n    setResult(\"importedHeight_last\", row, importedHeight);\n    setResult(\"importedChannels_last\", row, importedChannels);\n    setResult(\"importedSlices_last\", row, importedSlices);\n    setResult(\"importedFrames_last\", row, importedFrames);\n}\n\n\n// ============================================================\n// FINAL OUTPUT DIMENSIONS\n// ============================================================\n\nselectWindow(\"Output\");\n\ngetDimensions(finalWidth, finalHeight, finalChannels, finalSlices, finalFrames);\n\nsetResult(\"finalWidth\", row, finalWidth);\nsetResult(\"finalHeight\", row, finalHeight);\nsetResult(\"finalChannels\", row, finalChannels);\nsetResult(\"finalSlices\", row, finalSlices);\nsetResult(\"finalFrames\", row, finalFrames);\n\n\n// ============================================================\n// SHOW TABLE\n// ============================================================\n\nupdateResults();\n",
          "collapsed" : false
        },
