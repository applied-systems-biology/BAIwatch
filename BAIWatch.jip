      "/InputMode" : {
        "name" : "1 - Input mode (stitched or unstitched)",
        "description" : "Select whether the input is a <strong data-start=\"30\" data-end=\"48\">stitched \n    image</strong> or a <strong data-start=\"54\" data-end=\"84\">folder of \n    unstitched tiles</strong>. Tile filenames must include numbers that order \n    the tiles according to their acquisition sequence, using either raster or \n    serpentine scanning."
      },
      "1fe69d24-6568-43ee-b391-0021ce76530d/jipipe:local-parallelization-num-threads" : {
