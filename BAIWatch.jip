        "jipipe:metadata-v1" : {
          "location/_/y" : 67,
          "location/_/x" : 57,
          "location/6854939d-0900-4a58-ad81-291632fcd924/x" : 4,
          "location/6854939d-0900-4a58-ad81-291632fcd924/y" : 15
        },
        "jipipe:node-info-id" : "external-imagej-macro",
        "export-delay" : 250,
        "jipipe:algorithm:enabled" : true,
        "jipipe:node:ui-locked" : false,
        "code" : {
          "code" : "// To add variables, click the [+] button below.\n// They will be created automatically before this code fragment.\n\n// Each input image slot creates a window with its name.\n// You have to select it, first\nselectWindow(\"Input\");\n\nApplyBaSiC    = getJIPipeAnnotation(\"ApplyBaSiC\");\n\nif (ApplyBaSiC == \"true\") {\n\t\nrun(\"Properties...\", \"channels=1 slices=\"+nSlices+\" frames=1 pixel_width=1.0000 pixel_height=1.0000 voxel_depth=1.0000\");\nrun(\"BaSiC \", \"processing_stack=Input flat-field=Flat dark-field=Dark shading_estimation=[Skip estimation and use predefined shading profiles] shading_model=[Estimate both flat-field and dark-field] setting_regularisationparametes=Automatic temporal_drift=Ignore correction_options=[Compute shading and correct images] lambda_flat=0.50 lambda_dark=0.50\");\n\nselectImage(\"Flat-field:Input\");\nclose();\nselectImage(\"Dark-field:Input\");\nclose();\nselectImage(\"Flat\");\nclose();\nselectImage(\"Dark\");\nclose();\n\nselectImage(\"Corrected:Input\");\nrename(\"Output\");\n\n} else {\n    // Pass through the input image.\n    selectImage(\"Flat\");\n    close();\n    selectImage(\"Dark\");\n    close();\n    selectWindow(\"Input\");\n    rename(\"Output\");\n\n}",
          "collapsed" : false
        },
        "import-delay" : 1000,
        "jipipe:node:bookmarked" : false,
        "jipipe:algorithm:pass-through" : false,
        "jipipe:node:name" : "BASiC : Correct Illumination",
