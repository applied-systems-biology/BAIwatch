        },
        "jipipe:node-info-id" : "external-imagej-macro",
        "export-delay" : 250,
        "jipipe:algorithm:enabled" : true,
        "jipipe:node:ui-locked" : false,
        "code" : {
          "code" : "selectWindow(\"Input\");\n\n// Enable or disable the review dialogs.\nedit = false;\n\n// Build the path to the final ROI ZIP file.\nroiDir = getJIPipeAnnotation(\"#FullPathWithoutExtension\");\nroiPath = roiDir + \".zip\";\n\nprint(\"Final ROI path: \" + roiPath);\n\n// Load existing ROIs without review.\nif (File.exists(roiPath)) {\n    roiManager(\"Reset\");\n    roiManager(\"Open\", roiPath);\n    roiManager(\"Show All with labels\");\n    if (roiManager(\"count\") > 0) roiManager(\"Select\", 0);\n\n    rename(\"Output\");\n}\n\n// Review and save predicted ROIs if no saved file exists.\nif (!File.exists(roiPath)) {\n    if (roiManager(\"count\") == 0) exit(\"No predicted ROI available (ROI Manager is empty).\");\n\n    roiManager(\"Show All with labels\");\n    roiManager(\"Select\", 0);\n\n    // Show review dialogs only when editing is enabled.\n    if (edit) {\n        Dialog.create(\"Review predicted ROI\");\n        Dialog.addMessage(\"A predicted ROI has been overlaid on the image.\\n\\nChoose what to do:\");\n        Dialog.addChoice(\"Action:\", newArray(\"Accept as-is (save now)\", \"Edit ROI first (then save)\"), \"Edit ROI first (then save)\");\n        Dialog.show();\n        action = Dialog.getChoice();\n\n        if (action == \"Edit ROI first (then save)\") {\n            waitForUser(\"Please edit the ROI(s) as needed.\\n\\n\" + \"Tips:\\n\" + \"- Use ROI Manager to add/delete/select ROIs\\n\" + \"- Use the selection tools to move/resize\\n\\n\" + \"Click OK when finished to save the final ROI.\");\n        }\n    }\n\n    // Save the final ROIs.\n    roiManager(\"Save\", roiPath);\n    print(\"Saved final ROI to: \" + roiPath);\n\n    rename(\"Output\");\n}",
          "collapsed" : false
        },
