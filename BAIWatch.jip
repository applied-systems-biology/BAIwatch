              "save-outputs" : true,
              "is-optional" : false
            }
          },
          "output" : {
            "Output" : {
              "slot-data-type" : "imagej-imgplus",
              "slot-type" : "Output",
              "name" : "Output",
              "custom-name" : null,
              "description" : "",
              "is-virtual" : true,
              "save-outputs" : true,
              "is-optional" : false
            }
          }
        },
        "jipipe:metadata-v1" : {
          "location/_/y" : 83,
          "location/_/x" : 13,
          "location/dcaae8b0-9395-4c30-a425-c4164628f4df/y" : 5,
          "location/dcaae8b0-9395-4c30-a425-c4164628f4df/x" : 1
        },
        "jipipe:node-info-id" : "external-imagej-macro",
        "export-delay" : 250,
        "jipipe:algorithm:enabled" : true,
        "jipipe:node:ui-locked" : false,
        "code" : {
          "code" : "selectWindow(\"Input\");\n\ncolumns = parseInt(getJIPipeAnnotation(\"TilesY\"));\nrows = parseInt(getJIPipeAnnotation(\"TilesX\"));\n\ntargetWidth = 4000;\n\n// Process overlaps only when the input contains multiple slices.\nif (nSlices > 1) {\n    w = getWidth();\n    h = getHeight();\n\n    // Check whether overlap values are missing or nonnumeric.\n    tilesXMissing = isNaN(parseFloat(getJIPipeAnnotation(\"OverlapX\")));\n    tilesYMissing = isNaN(parseFloat(getJIPipeAnnotation(\"OverlapY\")));\n\n    // Convert overlap percentages to pixels and crop the tiles.\n    if (!tilesXMissing && !tilesYMissing) {\n        OverlapX = w * parseFloat(getJIPipeAnnotation(\"OverlapX\")) / 100;\n        OverlapY = h * parseFloat(getJIPipeAnnotation(\"OverlapY\")) / 100;\n\n        makeRectangle(0, 0, w - OverlapX, h - OverlapY);\n        run(\"Crop\");\n    }\n}\n\nrename(\"Output\");",
          "collapsed" : false
        },
        "import-delay" : 1000,
        "jipipe:node:bookmarked" : false,
        "jipipe:algorithm:pass-through" : false,
        "jipipe:node:name" : "Crop tile overlaps",
        "jipipe:algorithm:runtime-partition" : {
          "index" : 1
        },
        "jipipe:node:description" : "<html><head></head><body></body></html>",
        "external-code" : false,
