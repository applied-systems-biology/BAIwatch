        },
        "jipipe:metadata-v1" : {
          "location/_/y" : 63,
          "location/_/x" : 57,
          "location/6854939d-0900-4a58-ad81-291632fcd924/x" : 2,
          "location/6854939d-0900-4a58-ad81-291632fcd924/y" : 11
        },
        "jipipe:node-info-id" : "external-imagej-macro",
        "export-delay" : 250,
        "jipipe:algorithm:enabled" : true,
        "jipipe:node:ui-locked" : false,
        "code" : {
          "code" : "selectWindow(\"Input\");\n\napplyBaSiC = getJIPipeAnnotation(\"ApplyBaSiC\");\n\nif (applyBaSiC == \"true\") {\n    slices = getJIPipeAnnotation(\"TileNumbers\");\n\n    run(\"Make Substack...\", \"slices=\" + slices);\n    run(\"Properties...\", \"channels=1 slices=\" + nSlices + \" frames=1 pixel_width=1.0000 pixel_height=1.0000 voxel_depth=1.0000\");\n    rename(\"Substack\");\n\n    run(\"BaSiC \", \"processing_stack=Substack flat-field=None dark-field=None shading_estimation=[Estimate shading profiles] shading_model=[Estimate both flat-field and dark-field] setting_regularisationparametes=Automatic temporal_drift=Ignore correction_options=[Compute shading only] lambda_flat=0.50 lambda_dark=0.50\");\n\n    selectImage(\"Flat-field:Substack\");\n    rename(\"Flat-field\");\n\n    selectImage(\"Dark-field:Substack\");\n    rename(\"Dark-field\");\n\n    selectImage(\"Substack\");\n    close();\n} else {\n    newImage(\"Flat-field\", \"8-bit black\", 1, 1, 1);\n    newImage(\"Dark-field\", \"8-bit black\", 1, 1, 1);\n}",
          "collapsed" : false
        },
        "import-delay" : 1000,
        "jipipe:node:bookmarked" : false,
        "jipipe:algorithm:pass-through" : false,
        "jipipe:node:name" : "BASiC : Estimate Flat-Field",
