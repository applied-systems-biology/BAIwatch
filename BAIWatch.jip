    "docs" : {
      "f9c4de9b-148e-4d6d-a6fe-aea61d4138b3/split-slices" : {
        "name" : "Split slices",
        "description" : "If enabled, results are generated for each 2D slice. Otherwise all results are merged into one table and ROI."
      },
      "ee95e530-8208-460c-bf10-efa5165849b5/saturated-pixels" : {
        "name" : "Saturated pixels (%)",
        "description" : "Only used if histogram stretching is used.\nDetermines the number of pixels in the image that are allowed to become saturated. Increasing this value increases contrast. This value should be greater than zero to prevent a few outlying pixel from causing the histogram stretch to not work as intended. "
      },
      "73c5adf7-808f-4387-a987-1ec2adf8044c/generated-annotation" : {
        "name" : "Generated annotation",
        "description" : "Select which annotation type is generated for each path"
      },
      "c5aa339a-f4fa-4b5e-b403-a516374a2eba/jipipe:data-batch-generation/solver-preference" : {
        "pinned" : true,
        "name" : "Solver",
        "description" : "Allows to override the iteration step solver"
      },
      "ac1bac07-5bf9-4e40-971d-1143d146e021/annotation-type" : {
        "name" : "Removed annotations",
        "description" : "Annotations that match any of the filters are removed.\n\nThis parameter is an expression that has two modes: (1) Selecting an existing annotation by its name, and (2) Matching an existing annotation by boolean operators<br/><ol><li>Type in the name of the existing annotation. Put the name in double quotes (optional, but recommended). Example: <pre>\"#Dataset\"</pre></li><li>The function iterates through all annotations. It should return TRUE for one of them. You will have 'key' and 'value' available within the expression. Example: <pre>key == \"#Dataset\"</pre></li></ol>"
      },
      "1166424e-99d1-4135-9a14-6085eccf003e/jipipe:algorithm:enabled" : {
        "pinned" : true,
        "name" : "Enabled",
        "description" : "If disabled, this algorithm will be skipped in a run. Please note that this will also disable all algorithms dependent on this algorithm."
      },
      "78e3b277-3972-4af7-92b7-5ade6bfb9621/split-by-slot-name" : {
        "name" : "Split by output name",
        "description" : "If enabled, the exporter will attempt to split data by their output name. Has no effect if the exported data table is not an output of a node."
      },
      "f32f3a0c-bcb5-469c-8299-453c087df7b4/jipipe:local-parallelization-num-threads" : {
        "pinned" : true,
        "name" : "Local parallelization",
        "description" : "If enabled, override the partition- and run-wide parallelization settings and apply parallelization only on this node."
      },
      "519fc489-3ecc-4f0b-9bf4-9196222bfc33/output-from-imagej-importers/Results" : {
        "name" : "Results"
      },
      "91c30daf-4535-4fab-a66a-e9a3d6f632db/jipipe:environment-overrides/python" : {
        "name" : "Python",
        "description" : "Allows to override the Python environment. A Python environment"
      },
      "f061a6ff-97be-4abd-92b4-50ff7bdee7b6/jipipe:algorithm:pass-through" : {
        "pinned" : true,
        "name" : "Pass through",
        "description" : "If enabled, the algorithm will pass the input data directly to the output data without any processing. This is different from enabling/disabling the algorithm as this will not disable dependent algorithms.\nPlease note that setting this parameter via adaptive parameters (if available) does not always yield the expected result. The reason behind this is that pass-through is not trivial for certain nodes. We recommend to use a split node if node execution should be made adaptive."
      },
      "2accd6a2-525f-4375-9eca-a0e94c0317fe/jipipe:node:ui-locked" : {
        "pinned" : true,
        "hidden" : true,
        "name" : "Lock location/size",
        "description" : "If enabled, lock the location and size of this node. Does not affect automated alignment operations. Will lock the size if the node supports a resize handle. Will prevent deletion of the node by the user. Slots can still be edited/connected and parameters can still be changed."
      },
