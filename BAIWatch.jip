      "80ff5496-2d5f-4930-994e-cd1b31bcddeb/jipipe:data-batch-generation/annotation-matching-method" : {
        "name" : "Annotation matching method",
        "description" : "Allows to customize when two annotation sets are considered as equal. By default, non-empty annotation values should match exactly. You can also use a custom expression, instead."
      },
      "1e8533bd-4cb7-4580-8fdf-62b3f472a625/jipipe:parameter-slot-algorithm/parameter-annotations-use-internal-names" : {
        "name" : "Parameter annotations use internal names",
        "description" : "Generated parameter annotations use their internal unique names."
      },
      "f061a6ff-97be-4abd-92b4-50ff7bdee7b6/jipipe:node:bookmarked" : {
        "pinned" : true,
        "hidden" : true,
        "name" : "Bookmark this node",
        "description" : "If enabled, the node is highlighted in the graph editor UI and added into the bookmark list."
      },
      "f061a6ff-97be-4abd-92b4-50ff7bdee7b6/jipipe:data-batch-generation/skip-incomplete" : {
        "pinned" : true,
        "name" : "Skip incomplete data sets",
        "description" : "If enabled, incomplete data sets are silently skipped. Otherwise an error is displayed if such a configuration is detected."
      },
      "630ee10e-fba8-41a0-aa2e-2568900a82b0/counter-annotation-type" : {
        "name" : "Slice index annotation",
        "description" : "Data annotation that is used as reference for ordering the slices. Annotation values are lexicographically sorted."
      },
      "7fcdf524-63d3-4eb8-9681-cfff1959844f/column-c" : {
        "name" : "Column 'C'",
        "description" : "Table column that determines the channel location. For one-based positions, 0 indicates that the ROI is present in all channel-slices. For zero-based positions the value is -1 or lower.\n\nThis parameter can be used to either select an existing column from a table or to generate a new column by providing a value for each row.<ul><li>Selecting columns by exact name: Type in the name of the column into the value field. Quotation marks are optional.</li><li>Selecting columns by filtering: The value expression is called for each existing column and provided as variable 'value'. Return TRUE at any point to select the value. Example: <code>value == \"Mean\"</code></li><li>Generating columns: The value expression is called for each row. Return a string or number. You have access to the other column values inside the row (as variables). Example: <code>Mean + 0.5 * X</code>. If you do not provide a valid expression, the expression itself is put in as column value (string)</li></ul>"
      },
      "91c30daf-4535-4fab-a66a-e9a3d6f632db/cleanup-afterwards" : {
        "name" : "Clean up data after processing",
        "description" : "If enabled, data is deleted from temporary directories after the processing was finished. Disable this to make it possible to debug your scripts. The directories are accessible via the logs (Tools &gt; Logs)."
      },
      "e2dc7330-aa2c-4d0f-bc8f-1c8d385820ac/jipipe:adaptive-parameters/attach-parameter-annotations" : {
        "name" : "Attach parameter annotations",
        "description" : "If multiple parameters are allowed, attach the parameter values as annotations."
      },
      "c724b8f0-fa4b-41bf-91ab-51a755d02be5/jipipe:node:bookmarked" : {
        "pinned" : true,
        "hidden" : true,
        "name" : "Bookmark this node",
        "description" : "If enabled, the node is highlighted in the graph editor UI and added into the bookmark list."
      },
      "66cd8588-d03d-4e9c-9441-ed097411bead/jipipe:algorithm:pass-through" : {
        "pinned" : true,
        "name" : "Pass through",
        "description" : "If enabled, the algorithm will pass the input data directly to the output data without any processing. This is different from enabling/disabling the algorithm as this will not disable dependent algorithms.\nPlease note that setting this parameter via adaptive parameters (if available) does not always yield the expected result. The reason behind this is that pass-through is not trivial for certain nodes. We recommend to use a split node if node execution should be made adaptive."
      },
      "1a429057-a0e9-4f90-91a9-d445e6c2c675/jipipe:data-batch-generation/data-annotation-merge-strategy" : {
        "name" : "Merge same data annotation values",
        "description" : "Determines which strategy is applied if different values for the same data annotation columns are encountered."
      },
      "bd9cc699-27b1-46d9-a9ab-6bf0f9cfc9ee/jipipe:algorithm:enabled" : {
        "pinned" : true,
        "name" : "Enabled",
        "description" : "If disabled, this algorithm will be skipped in a run. Please note that this will also disable all algorithms dependent on this algorithm."
      },
      "3524bb11-10f2-4dfd-950c-6a4d157d3378/jipipe:adaptive-parameters/parameter-annotations-use-internal-names" : {
        "name" : "Parameter annotations use internal names",
        "description" : "Generated parameter annotations use their internal unique names."
      },
      "48090aa2-2435-4632-a59e-3273dbdfcdc6/jipipe:compartment:output-slot-name" : {
        "hidden" : true,
        "name" : "jipipe:compartment:output-slot-name"
      },
      "4cbb65c3-8dd7-49f3-a03c-88d16f807d1b/jipipe:parameter-slot-algorithm/attach-only-non-default-parameter-annotations" : {
        "name" : "Attach only non-default parameter annotations",
        "description" : "If multiple parameters are allowed, attach only parameter annotations that have different values from the current settings. Requires 'Attach parameter annotations' to be enabled."
      },
      "7bb039e3-e7ec-45e8-a26f-3c60e1ed8a37/jipipe:local-parallelization-num-threads" : {
        "pinned" : true,
        "name" : "Local parallelization",
        "description" : "If enabled, override the partition- and run-wide parallelization settings and apply parallelization only on this node."
      },
      "1c00bd94-1114-4b56-8add-e969a77e8d63/table-merge-settings/custom-annotation-matching" : {
        "name" : "Custom annotation matching method",
        "description" : "Expression used to compare two annotation sets."
      },
      "cd8ed654-8943-408f-ab52-551258733930/threshold-annotation-strategy" : {
        "name" : "Threshold annotation mode",
        "description" : "Determines what happens if annotations are already present."
      },
      "f32f3a0c-bcb5-469c-8299-453c087df7b4/jipipe:parameter-slot-algorithm/attach-only-non-default-parameter-annotations" : {
        "name" : "Attach only non-default parameter annotations",
        "description" : "If multiple parameters are allowed, attach only parameter annotations that have different values from the current settings. Requires 'Attach parameter annotations' to be enabled."
      },
      "e9af723b-6313-4505-b2b7-2bd9edbe9be6/code" : {
        "name" : "Code",
        "description" : "The macro code. Images are opened as windows named according to the input slot. You have to select windows with the select() function or comparable functions. You have have one results table input which can be addressed via the global functions. Input ROI are merged into one ROI manager.\n\nYou can define variables that are passed from JIPipe to ImageJ. Variables are also created for incoming path-like data, named according to the slot name. Annotations can also be accessed via a function getJIPipeAnnotation(key) or getJIPipeTextAnnotation(key), which returns the string value of the annotation or an empty string if no value was set."
      },
      "630ee10e-fba8-41a0-aa2e-2568900a82b0/jipipe:parameter-slot-algorithm/attach-parameter-annotations" : {
        "name" : "Attach parameter annotations",
        "description" : "If multiple parameters are allowed, attach the parameter values as annotations."
      }
    },
