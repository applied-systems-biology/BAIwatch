      "1fe69d24-6568-43ee-b391-0021ce76530d" : {
        "jipipe:graph-compartment" : "999c9b80-1dfc-453a-b7c1-d9fabe699cfb",
        "jipipe:alias-id" : "blocks-to-tiles",
        "jipipe:slot-configuration" : {
          "input" : {
            "Input" : {
              "slot-data-type" : "imagej-imgplus",
              "slot-type" : "Input",
              "name" : "Input",
              "custom-name" : null,
              "description" : "",
              "is-virtual" : false,
              "save-outputs" : true,
              "is-optional" : false
            },
            "Input 1" : {
              "slot-data-type" : "imagej-results-table",
              "slot-type" : "Input",
              "name" : "Input 1",
              "custom-name" : null,
              "description" : "",
              "is-virtual" : false,
              "save-outputs" : true,
              "is-optional" : false
            }
          },
          "output" : {
            "Output" : {
              "slot-data-type" : "imagej-imgplus",
              "slot-type" : "Output",
              "name" : "Output",
              "custom-name" : "TILES",
              "description" : "",
              "is-virtual" : false,
              "save-outputs" : true,
              "is-optional" : false
            },
            "Output 1" : {
              "slot-data-type" : "imagej-imgplus",
              "slot-type" : "Output",
              "name" : "Output 1",
              "custom-name" : null,
              "description" : "",
              "is-virtual" : false,
              "save-outputs" : true,
              "is-optional" : false
            }
          }
        },
        "jipipe:metadata-v1" : {
          "location/_/y" : 70,
          "location/999c9b80-1dfc-453a-b7c1-d9fabe699cfb/x" : 1,
          "location/_/x" : 5,
          "location/999c9b80-1dfc-453a-b7c1-d9fabe699cfb/y" : 82
        },
        "jipipe:node-info-id" : "cpython-script-iterating",
        "annotation-merge-strategy" : "OverwriteExisting",
        "jipipe:algorithm:enabled" : true,
        "jipipe:node:ui-locked" : false,
        "code" : {
          "code" : "from jipipe.imagej import *\nimport numpy as np\nimport math\nimport cv2\n# ============================================================\n# INPUT\n# ============================================================\n\nds = jipipe_inputs[\"Input\"]\nblocks = load_image_file(data_slot=ds, row=0)\n\nprint(\"Input shape:\", blocks.shape)\n\nds = jipipe_inputs[\"Input 1\"]\ntable = load_table_file(data_slot=ds, row=0)\n\n\n\n# ============================================================\n# PARAMETERS FROM IMAGEJ RESULTS TABLE\n# ============================================================\n\nselected_c = int(list(table[\"selectedC\"])[0])\nselected_z = int(list(table[\"selectedZ\"])[0])\nselected_t = int(list(table[\"selectedT\"])[0])\n\ntotal_cols = int(list(table[\"totalTileCols\"])[0])\ntotal_rows = int(list(table[\"totalTileRows\"])[0])\n\ntile_w = int(list(table[\"tileWidth\"])[0])\ntile_h = int(list(table[\"tileHeight\"])[0])\n\n#tile_w_new = int(list(table[\"finalWidth\"])[0])\n#tile_h_new = int(list(table[\"finalHeight\"])[0])\n\nsize_x = int(list(table[\"sizeX\"])[0])\nsize_y = int(list(table[\"sizeY\"])[0])\n\n#size_x_new = total_cols * tile_w_new\n#size_y_new = total_rows * tile_h_new\n\nsize_c = int(list(table[\"sizeC\"])[0])\nsize_z = int(list(table[\"sizeZ\"])[0])\nsize_t = int(list(table[\"sizeT\"])[0])\n\n\nmax_pixels_per_crop = int(list(table[\"maxPixelsPerCrop\"])[0])\n\nis_small = bool(int(list(table[\"isSmall\"])[0]))\nis_large = bool(int(list(table[\"isLarge\"])[0]))\n\n\n# ============================================================\n# OPTIONAL BLOCK PARAMETERS\n# ============================================================\n#\n# These exist for large images in your ImageJ table.\n# Using them directly is better than recalculating them\n# independently in Python.\n# ============================================================\n\nif is_large:\n    pixels_per_tile = int(list(table[\"pixelsPerTile\"])[0])\n    max_tiles_per_block = int(list(table[\"maxTilesPerBlock\"])[0])\n\n    max_block_cols = int(list(table[\"maxBlockTileCols\"])[0])\n    max_block_rows = int(list(table[\"maxBlockTileRows\"])[0])\n\n    block_width = int(list(table[\"blockWidth\"])[0])\n    block_height = int(list(table[\"blockHeight\"])[0])\n    block_pixels = int(list(table[\"blockPixels\"])[0])\n\n\n# ============================================================\n# CHECK PARAMETERS\n# ============================================================\n\nprint(\"tile_w:\", tile_w)\nprint(\"tile_h:\", tile_h)\n\nprint(\"size_x:\", size_x)\nprint(\"size_y:\", size_y)\n\nprint(\"total_cols:\", total_cols)\nprint(\"total_rows:\", total_rows)\n\nprint(\"is_small:\", is_small)\nprint(\"is_large:\", is_large)\n\nprint(\"max_pixels_per_crop:\", max_pixels_per_crop)\n\n\n# ============================================================\n# CHECK IF INPUT IS ALREADY A TILE STACK\n# ============================================================\n#\n# If ImageJ handled the image through the small-image branch,\n# Montage to Stack has already converted it into microscope tiles.\n# ============================================================\n\nalready_tiles = is_small\n\n\n# ============================================================\n# IF ALREADY TILES: DO NOTHING\n# ============================================================\n\nif already_tiles:\n\n    print(\"Input already contains microscope tiles.\")\n    scale = float(jipipe_annotations[\"Scale\"])\n    if scale != 1:\n        blocks= cv2.resize(blocks, (0, 0), fx=scale, fy=scale, interpolation=cv2.INTER_NEAREST)\n\n    sorted_tiles = blocks\n    try:\n        number_of_tiles, tile_h_new, tile_w_new = sorted_tiles.shape\n    except:\n    \ttile_h_new,tile_w_new = sorted_tiles.shape\n    \t\n    \t\n\n    # add resizing\n\n# ============================================================\n# OTHERWISE: BLOCK STACK -> TILE STACK\n# ============================================================\n\nelse:\n\n    print(\"Input contains larger blocks. Splitting into tiles.\")\n\n    print(\"total_cols:\", total_cols)\n    print(\"total_rows:\", total_rows)\n\n    print(\n        \"block tiles:\",\n        max_block_cols,\n        \"x\",\n        max_block_rows\n    )\n\n\n    # --------------------------------------------------------\n    # Normalize a single block to stack form if necessary\n    # --------------------------------------------------------\n\n    if blocks.ndim == 2:\n        blocks = blocks[np.newaxis, :, :]\n    elif blocks.ndim == 3:\n        expected_z = min(blocks.shape)\n        if blocks.shape[0] == expected_z:\n            pass\n        elif blocks.shape[-1] == expected_z:\n            blocks = np.moveaxis(blocks, -1, 0)\n        else:\n            raise ValueError( f\"Cannot identify Z-axis. Shape: {blocks.shape}, expected Z: {expected_z}\")\n    else:\n        raise ValueError(f\"Expected a 2D image or 3D stack, got {blocks.shape}\")\n\n    # --------------------------------------------------------\n    # Extract tiles from each block\n    # --------------------------------------------------------\n\n    tiles_by_position = {}\n\n    block_index = 0\n\n    for start_row in range(\n        0,\n        total_rows,\n        max_block_rows\n    ):\n\n        for start_col in range(\n            0,\n            total_cols,\n            max_block_cols\n        ):\n\n            block = blocks[block_index]\n\n            block_index += 1\n\n            block_cols = min(\n                max_block_cols,\n                total_cols - start_col\n            )\n\n            block_rows = min(\n                max_block_rows,\n                total_rows - start_row\n            )\n\n            for r in range(block_rows):\n\n                for c in range(block_cols):\n\n                    x0 = c * tile_w\n                    y0 = r * tile_h\n\n                    tile = block[\n                        y0:y0 + tile_h,\n                        x0:x0 + tile_w\n                    ]\n\n                    global_row = start_row + r\n                    global_col = start_col + c\n\n                    tiles_by_position[\n                        (global_row, global_col)\n                    ] = tile\n\n\n    # --------------------------------------------------------\n    # Sort tiles globally row-by-row\n    # --------------------------------------------------------\n\n    sorted_tiles = []\n\n    for row in range(total_rows):\n\n        for col in range(total_cols):\n        \tscale = float(jipipe_annotations[\"Scale\"])\n        \tif scale != 1:\n        \t\tsorted_tiles.append(cv2.resize(tiles_by_position[(row, col)], (0, 0), fx=scale, fy=scale, interpolation=cv2.INTER_NEAREST))\n        \telse:\n        \t\tsorted_tiles.append(tiles_by_position[(row, col)])\n\n    sorted_tiles = np.stack(sorted_tiles)\n\n    number_of_tiles, tile_h_new, tile_w_new = sorted_tiles.shape\n\nfrom skimage.transform import resize\n\ngrid_width = total_cols * tile_w_new\ngrid_height = total_rows * tile_h_new\n\ntarget_width = 4000\n\nscale = target_width / grid_width\n\nnew_tile_w = round(tile_w_new * scale)\nnew_tile_h = round(tile_h_new * scale)\n\ntry:\n    number_of_tiles\n    resized_tiles = np.stack([\n        resize(\n            tile,\n            (new_tile_h, new_tile_w),\n            preserve_range=True,\n            anti_aliasing=True\n            )\n        for tile in sorted_tiles\n        ]).astype(sorted_tiles.dtype)\nexcept:\n\tresized_tiles = resize(\n        sorted_tiles,\n        (new_tile_h, new_tile_w),\n        preserve_range=True,\n        anti_aliasing=True\n    )\n\nprint(\"Original grid:\", grid_width, \"x\", grid_height)\nprint(\"Scale:\", scale)\nprint(\"Scaled tile:\", new_tile_w, \"x\", new_tile_h)\nprint(\"Scaled montage approx:\",\n      new_tile_w * total_cols,\n      \"x\",\n      new_tile_h * total_rows)\n\nannotations={\"NbTilesX\":str(total_rows),\n\"NbTilesY\":str(total_cols),\n\"size_x\":str(size_x),\n\"grid_width\":str(grid_width),\n\"grid_height\":str(grid_height),\n\n\"tile_w_new\":str(tile_w_new),\n\"tile_h_new\":str(tile_h_new),\n\n}\n\n\n\n\ndso = jipipe_outputs[\"Output\"]\nadd_image(sorted_tiles, dso, text_annotations=annotations)\n\ndso = jipipe_outputs[\"Output 1\"]\nadd_image(resized_tiles, dso, text_annotations=annotations)",
          "collapsed" : false
        },
        "suppress-logs" : false,
