        "jipipe:node-info-id" : "external-imagej-macro",
        "export-delay" : 250,
        "jipipe:algorithm:enabled" : true,
        "jipipe:node:ui-locked" : false,
        "code" : {
          "code" : "selectWindow(\"Input\");\n\n// Build the path to the ROI ZIP file.\nroiDir = getJIPipeAnnotation(\"#FullPathWithoutExtension\");\nroiPath = roiDir + \".zip\";\n\nprint(\"ROI path: \" + roiPath);\n\n// Clear the ROI Manager and load the saved ROIs.\nroiManager(\"Reset\");\nroiManager(\"Open\", roiPath);\n\n// Display all ROIs with labels and select the first ROI.\nroiManager(\"Show All with labels\");\nroiManager(\"Select\", 0);\n\nrename(\"Output\");",
          "collapsed" : false
        },
        "import-delay" : 1000,
