      "4cbb65c3-8dd7-49f3-a03c-88d16f807d1b" : {
        "jipipe:graph-compartment" : "7950851b-ccdb-446f-961f-3cc28fe8814d",
        "jipipe:alias-id" : "export-tiles-for-stitching",
        "jipipe:slot-configuration" : {
          "input" : {
            "Input" : {
              "slot-data-type" : "imagej-imgplus",
              "slot-type" : "Input",
              "name" : "Input",
              "custom-name" : null,
              "description" : "",
              "is-virtual" : true,
              "save-outputs" : true,
              "is-optional" : false
            }
          },
          "output" : {
            "Output" : {
              "slot-data-type" : "imagej-imgplus",
              "slot-type" : "Output",
              "name" : "Output",
              "custom-name" : null,
              "description" : "",
              "is-virtual" : true,
              "save-outputs" : true,
              "is-optional" : false
            }
          }
        },
        "jipipe:metadata-v1" : {
          "location/7950851b-ccdb-446f-961f-3cc28fe8814d/y" : 6,
          "location/_/y" : 5,
          "location/7950851b-ccdb-446f-961f-3cc28fe8814d/x" : 1,
          "location/_/x" : 1
        },
        "jipipe:node-info-id" : "cpython-script-iterating",
        "annotation-merge-strategy" : "Merge",
        "jipipe:algorithm:enabled" : true,
        "jipipe:node:ui-locked" : false,
        "code" : {
          "code" : "from jipipe.imagej import *\nfrom skimage.io import imsave\nfrom pathlib import Path\nimport shutil\nimport os\nimport stat\n\n\n# Maximum allowed number of pixels\nMAX_PIXELS = 1_000_000_000\n\n\n# Remove a folder and its contents, retrying read-only files.\ndef rm_tree(path: Path):\n    if not path.exists():\n        return\n\n    def _on_rm_error(func, p, exc_info):\n        # Make the file writable and retry removal.\n        try:\n            os.chmod(p, stat.S_IWRITE)\n        except Exception:\n            pass\n        func(p)\n\n    shutil.rmtree(path, onerror=_on_rm_error)\n\n\n# Load the input stack.\nds = jipipe_inputs[\"Input\"]\nstack = load_image_file(data_slot=ds, row=0)\n\n\nif jipipe_annotations[\"Stitching\"] == \"true\":\n\n    # Calculate the total number of spatial pixels.\n    # stack.shape is assumed to be:\n    # (number_of_tiles, height, width)\n    total_pixels = (\n        stack.shape[0]\n        * stack.shape[-2]\n        * stack.shape[-1]\n    )\n\n    print(f\"Number of tiles: {stack.shape[0]}\")\n    print(f\"Tile size: {stack.shape[-1]} x {stack.shape[-2]}\")\n    print(f\"Total pixels: {total_pixels:,}\")\n    print(f\"Maximum allowed: {MAX_PIXELS:,}\")\n\n\n    # Only prepare images for stitching if below the limit.\n    if total_pixels <= MAX_PIXELS:\n\n        print(\"Pixel count OK. Starting stitching preparation...\")\n\n        # Choose the stitching folder location.\n        base_path = Path(\n            jipipe_annotations[\"#FullPathWithoutExtension\"]\n        )\n\n        input_mode = (\n            jipipe_annotations[\"InputMode\"]\n            .strip()\n            .lower()\n        )\n\n        if input_mode == \"unstitched\":\n            folder = base_path.parent / \"to_stitch\"\n        else:\n            folder = base_path / \"to_stitch\"\n\n        # Recreate the stitching folder.\n        rm_tree(folder)\n        folder.mkdir(\n            parents=True,\n            exist_ok=True\n        )\n\n        print(\n            \"Folder recreated:\",\n            folder.resolve()\n        )\n\n        # Export each slice as a numbered TIFF file.\n        ext = \".tif\"\n\n        for i in range(stack.shape[0]):\n            fname = f\"{i:04d}{ext}\"\n\n            imsave(\n                str(folder / fname),\n                stack[i]\n            )\n\n        print(\n            f\"Exported {stack.shape[0]} tiles for stitching.\"\n        )\n\n        # Output a zero image.\n        dso = jipipe_outputs[\"Output\"]\n        add_image(stack[0] * 0, dso)\n    else:\n\n        raise RuntimeError(\n                f\"Stitching skipped. \"\n                f\"Image contains {total_pixels:,} pixels, \"\n                f\"which exceeds the limit of {MAX_PIXELS:,} pixels.\"\n                )\n\n        dso = jipipe_outputs[\"Output\"]\n        add_image(stack[0] * 0, dso)\n",
          "collapsed" : false
        },
        "suppress-logs" : false,
        "jipipe:node:bookmarked" : false,
        "jipipe:algorithm:pass-through" : false,
        "jipipe:node:name" : "Export tiles for stitching",
        "jipipe:algorithm:runtime-partition" : {
          "index" : 1
        },
        "jipipe:node:description" : "<html><head></head><body></body></html>",
        "external-code" : false,
        "cleanup-afterwards" : true,
        "jipipe:local-parallelization-num-threads" : {
          "content" : 1,
          "enabled" : false
        },
        "jipipe:algorithm:custom-expression-variables" : {
          "parameters" : { }
        },
        "jipipe:environment-overrides" : {
          "parameters" : {
            "jipipe-python-adapter-library" : {
              "key" : "jipipe-python-adapter-library",
              "name" : "JIPipe Python adapter library",
              "description" : "Allows to override the JIPipe Python adapter library environment. Additional library for Python",
              "hidden" : false,
              "field-class" : "org.hkijena.jipipe.plugins.python.adapter.OptionalJIPipePythonAdapterLibraryEnvironment",
              "value" : {
                "content" : {
                  "name" : "Default",
