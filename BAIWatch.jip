        "jipipe:metadata-v1" : {
          "location/_/y" : 6,
          "location/999c9b80-1dfc-453a-b7c1-d9fabe699cfb/x" : 13,
          "location/_/x" : 1,
          "location/999c9b80-1dfc-453a-b7c1-d9fabe699cfb/y" : 95
        },
        "jipipe:node-info-id" : "modify-annotation-script",
        "jipipe:algorithm:enabled" : true,
        "jipipe:node:ui-locked" : false,
        "code" : {
          "code" : "# Read pixel size, disk radius, and grid width.\noriginal_resolution = float(annotations[\"Resolution\"])\nradius_mm = float(annotations[\"Radius\"])\ngrid_width_croped = float(annotations[\"grid_width_croped\"])\n\n# Calculate pixel size for the montage resized to 4000 pixels wide.\nfinal_resolution = original_resolution * grid_width_croped / 4000\n\n# Convert the radius from millimeters to pixels, accounting for the image scale.\nscale = float(annotations[\"Scale\"])\nannotations[\"Radius\"] = int(round(radius_mm * 1e6 * scale / final_resolution))",
          "collapsed" : false
        },
        "jipipe:node:bookmarked" : false,
