      "9aa083d4-45a5-4a3c-9bc1-abc9c65f5e83" : {
        "jipipe:graph-compartment" : "dcaae8b0-9395-4c30-a425-c4164628f4df",
        "jipipe:alias-id" : "resize-image-to-width-4000-1",
        "jipipe:slot-configuration" : {
          "input" : {
            "Input" : {
              "slot-data-type" : "imagej-imgplus",
              "slot-type" : "Input",
              "name" : "Input",
