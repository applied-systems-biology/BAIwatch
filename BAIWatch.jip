              "name" : "Output",
              "custom-name" : null,
              "description" : "",
              "is-virtual" : true,
              "save-outputs" : true,
              "is-optional" : false
            },
            "Table" : {
              "slot-data-type" : "imagej-results-table",
              "slot-type" : "Output",
              "name" : "Table",
              "custom-name" : null,
              "description" : "",
              "is-virtual" : false,
              "save-outputs" : true,
              "is-optional" : false
            }
          }
        },
        "jipipe:metadata-v1" : {
          "location/_/y" : 17,
          "location/_/x" : 68,
          "location/dcaae8b0-9395-4c30-a425-c4164628f4df/y" : 25,
          "location/dcaae8b0-9395-4c30-a425-c4164628f4df/x" : 4
        },
        "jipipe:node-info-id" : "cpython-script-iterating",
        "annotation-merge-strategy" : "Merge",
        "jipipe:algorithm:enabled" : true,
        "jipipe:node:ui-locked" : false,
        "code" : {
          "code" : "from jipipe.imagej import *\nimport numpy as np\nimport pandas as pd\nfrom skimage.transform import resize\nfrom pathlib import Path\n\n# Load the image tiles and montage mask.\nds = jipipe_inputs[\"Input\"]\ntiles = load_image_file(data_slot=ds, row=0)\n\nds = jipipe_inputs[\"Input 1\"]\nmontage_mask = load_image_file(data_slot=ds, row=0)\n\n# Use the threshold table when a negative control is specified.\nnegative_control = jipipe_annotations[\"nameOfNegativeControl\"]\n\nif negative_control is not None and str(negative_control).strip().lower() not in (\"\", \"none\", \"null\", \"nan\"):\n    # Check that the annotated input path exists.\n    path = Path(str(jipipe_annotations[\"#FullPath\"]).strip())\n\n    if path.exists():\n        ds = jipipe_inputs[\"Input 2\"]\n        df = load_table_file(data_slot=ds, row=0)\n        coverage_threshold = float(df[\"CoverageThreshold\"].iloc[0])\n    else:\n        raise KeyError(\"Missing negative file !\")\nelse:\n    # Use the manually specified threshold.\n    coverage_threshold = int(float(jipipe_annotations[\"CoverageThreshold\"]))\n\n# Convert a single tile to stack form and remove singleton mask dimensions.\nif tiles.ndim == 2:\n    tiles = tiles[np.newaxis, :, :]\n\nmontage_mask = np.squeeze(montage_mask)\n\n# Validate image and mask dimensions.\nif tiles.ndim != 3:\n    raise ValueError(f\"Tiles must be 3D. Got: {tiles.shape}\")\n\nif montage_mask.ndim != 2:\n    raise ValueError(f\"Montage mask must be 2D. Got: {montage_mask.shape}\")\n\n# Read grid dimensions and validate the tile count.\ntiles_x = int(float(jipipe_annotations[\"TilesX\"]))\ntiles_y = int(float(jipipe_annotations[\"TilesY\"]))\n\nnumber_of_tiles, tile_height, tile_width = tiles.shape\n\nif number_of_tiles != tiles_x * tiles_y:\n    raise ValueError(f\"Found {number_of_tiles} tiles, but the grid requires {tiles_x * tiles_y}\")\n\n# Divide the montage mask into tile regions.\nmask_height, mask_width = montage_mask.shape\n\nx_edges = np.linspace(0, mask_width, tiles_x + 1).round().astype(int)\ny_edges = np.linspace(0, mask_height, tiles_y + 1).round().astype(int)\n\nbinary_masks = np.zeros(tiles.shape, dtype=bool)\n\n# Resize each mask region to its corresponding tile dimensions.\nfor tile_index in range(number_of_tiles):\n    row = tile_index // tiles_x\n    column = tile_index % tiles_x\n\n    x_start = x_edges[column]\n    x_end = x_edges[column + 1]\n    y_start = y_edges[row]\n    y_end = y_edges[row + 1]\n\n    small_tile_mask = montage_mask[y_start:y_end, x_start:x_end]\n    resized_tile_mask = resize(small_tile_mask, (tile_height, tile_width), order=0, preserve_range=True, anti_aliasing=False)\n    binary_masks[tile_index] = resized_tile_mask > 0\n\n# Identify fluorescence-positive pixels inside the valid mask.\nbinary_tiles = tiles > coverage_threshold\ncovered_masks = binary_tiles & binary_masks\n\ntotal_mask_area = int(np.sum(binary_masks))\ntotal_covered_area = int(np.sum(covered_masks))\n\n# Calculate coverage as a percentage of the valid mask area.\nif total_mask_area > 0:\n    coverage_fraction = total_covered_area / total_mask_area\nelse:\n    coverage_fraction = 0.0\n\ncoverage_percent = coverage_fraction * 100.0\n\n# Output the coverage measurement.\nresults = pd.DataFrame({\n    \"File\": [jipipe_annotations[\"#FILE\"]],\n    \"CoveragePercent (%)\": [coverage_percent]\n})\n\ndso = jipipe_outputs[\"Table\"]\nadd_table(results, dso)\n\n# Output the covered regions as an unsigned 8-bit mask with values 0 and 1.\ncovered_masks = covered_masks.astype(np.uint8)\n\ndso = jipipe_outputs[\"Output\"]\nadd_image(covered_masks, dso)",
          "collapsed" : false
        },
        "suppress-logs" : false,
        "jipipe:node:bookmarked" : false,
        "jipipe:algorithm:pass-through" : false,
        "jipipe:node:name" : "Measure masked surface coverage",
        "jipipe:algorithm:runtime-partition" : {
          "index" : 1
