        "jipipe:metadata-v1" : {
          "location/_/y" : 50,
          "location/999c9b80-1dfc-453a-b7c1-d9fabe699cfb/x" : 1,
          "location/_/x" : 1,
          "location/999c9b80-1dfc-453a-b7c1-d9fabe699cfb/y" : 64
        },
        "jipipe:node-info-id" : "external-imagej-macro",
        "export-delay" : 250,
        "jipipe:algorithm:enabled" : true,
        "jipipe:node:ui-locked" : false,
        "code" : {
          "code" : "selectWindow(\"Input\");\n\ninputFile = getJIPipeAnnotation(\"#FullPath\");\n\ntileWidthValue  = getJIPipeAnnotation(\"TileWidth\");\ntileHeightValue = getJIPipeAnnotation(\"TileHeight\");\ntilesXValue     = getJIPipeAnnotation(\"TilesX\");\ntilesYValue     = getJIPipeAnnotation(\"TilesY\");\n\n\n/* Convert annotations to numbers.\n * Missing or nonnumeric values become NaN.\n */\n\ntileWidth  = parseFloat(tileWidthValue);\ntileHeight = parseFloat(tileHeightValue);\ntilesX     = parseFloat(tilesXValue);\ntilesY     = parseFloat(tilesYValue);\n\n\n/* Verify the source path. */\n\nif (inputFile == \"\" || inputFile == \"None\")\n    exit(\"The #FullPath annotation is missing.\");\n\n\n/* Read the complete image dimensions. */\n\nrun(\"Bio-Formats Macro Extensions\");\n\nExt.setId(inputFile);\n\nExt.getSizeX(sizeX);\nExt.getSizeY(sizeY);\nExt.getSizeC(sizeC);\nExt.getSizeZ(sizeZ);\nExt.getSizeT(sizeT);\n\nExt.close();\n\n\n/* Determine which values are missing. */\n\ntileWidthMissing  = isNaN(tileWidth);\ntileHeightMissing = isNaN(tileHeight);\ntilesXMissing     = isNaN(tilesX);\ntilesYMissing     = isNaN(tilesY);\n\n\n/* Convert supplied values to integers. */\n\nif (!tileWidthMissing)\n    tileWidth = round(tileWidth);\n\nif (!tileHeightMissing)\n    tileHeight = round(tileHeight);\n\nif (!tilesXMissing)\n    tilesX = round(tilesX);\n\nif (!tilesYMissing)\n    tilesY = round(tilesY);\n\n\n/*\n * This flag is changed to 1 if the supplied tile parameters\n * are invalid or inconsistent.\n */\n\ninvalidConfiguration = 0;\n\n\n/* Check the supplied X values. */\n\nif (!tileWidthMissing) {\n    if (tileWidth < 1 || tileWidth > sizeX)\n        invalidConfiguration = 1;\n}\n\nif (!tilesXMissing) {\n    if (tilesX < 1 || tilesX > sizeX)\n        invalidConfiguration = 1;\n}\n\n\n/* Check the supplied Y values. */\n\nif (!tileHeightMissing) {\n    if (tileHeight < 1 || tileHeight > sizeY)\n        invalidConfiguration = 1;\n}\n\nif (!tilesYMissing) {\n    if (tilesY < 1 || tilesY > sizeY)\n        invalidConfiguration = 1;\n}\n\n\n/*\n * Resolve the X-axis parameters, provided that the\n * configuration has not already been found invalid.\n */\n\nif (invalidConfiguration == 0) {\n\n    if (tileWidthMissing && tilesXMissing) {\n\n        tileWidth = sizeX;\n        tilesX = 1;\n\n    } else if (!tileWidthMissing && tilesXMissing) {\n\n        tilesX = round(sizeX / tileWidth);\n        \n\n    } else if (tileWidthMissing && !tilesXMissing) {\n\n        tileWidth = round(sizeX / tilesX);\n        \n\n    } else {\n\n        expectedTilesX = round(sizeX / tileWidth);\n\n        if (tilesX != expectedTilesX)\n            invalidConfiguration = 1;\n    }\n}\n\n\n/*\n * Resolve the Y-axis parameters, provided that the\n * configuration has not already been found invalid.\n */\n\nif (invalidConfiguration == 0) {\n\n    if (tileHeightMissing && tilesYMissing) {\n\n        tileHeight = sizeY;\n        tilesY = 1;\n\n    } else if (!tileHeightMissing && tilesYMissing) {\n\n        tilesY = round(sizeY / tileHeight);\n\n    } else if (tileHeightMissing && !tilesYMissing) {\n\n        tileHeight = round(sizeY / tilesY);\n\n    } else {\n\n        expectedTilesY = round(sizeY / tileHeight);\n\n        if (tilesY != expectedTilesY)\n            invalidConfiguration = 1;\n    }\n}\n\n\n/*\n * If any supplied values were inconsistent, use the complete\n * image as one tile.\n */\n\nif (invalidConfiguration == 1) {\n\n    tileWidth = sizeX;\n    tileHeight = sizeY;\n\n    tilesX = 1;\n    tilesY = 1;\n\n    parameterStatus = \"Invalid parameters: single-tile fallback used\";\n\n} else {\n\n    parameterStatus = \"Tile parameters accepted\";\n    x= sizeX / tileWidth;\n    remainderX = sizeX - round(x) * tileWidth;    \n\n    \n    if (round(x) < x) {\n        tileWidth = tileWidth+floor(remainderX/round(x));\n}\nif (round(sizeY / tileHeight) < sizeY / tileHeight) {\n    y= sizeY / tileHeight;\n    remainderY = sizeY - round(y) * tileHeight; \n\t\n    tileHeight=tileHeight+floor(remainderY/round(y));\n}\n}\n\n\n\n/* Calculate the dimensions of the boundary tiles. */\n\nlastTileWidth = sizeX - ((tilesX - 1) * tileWidth);\nlastTileHeight = sizeY - ((tilesY - 1) * tileHeight);\n\n\n/* Write the results. */\n\nrow = nResults;\n\nsetResult(\"ImageWidth\", row, sizeX);\nsetResult(\"ImageHeight\", row, sizeY);\n\nsetResult(\"SizeC\", row, sizeC);\nsetResult(\"SizeZ\", row, sizeZ);\nsetResult(\"SizeT\", row, sizeT);\n\nsetResult(\"TileWidth\", row, tileWidth);\nsetResult(\"TileHeight\", row, tileHeight);\n\nsetResult(\"TilesX\", row, tilesX);\nsetResult(\"TilesY\", row, tilesY);\n\nsetResult(\"LastTileWidth\", row, lastTileWidth);\nsetResult(\"LastTileHeight\", row, lastTileHeight);\n\nif (lastTileWidth != tileWidth)\n    setResult(\"PartialTileX\", row, 1);\nelse\n    setResult(\"PartialTileX\", row, 0);\n\nif (lastTileHeight != tileHeight)\n    setResult(\"PartialTileY\", row, 1);\nelse\n    setResult(\"PartialTileY\", row, 0);\n\nsetResult(\"SingleTileFallback\", row, invalidConfiguration);\nsetResult(\"ParameterStatus\", row, parameterStatus);\n\nupdateResults();\n\nrename(\"Output\");",
          "collapsed" : false
        },
        "import-delay" : 1000,
        "jipipe:node:bookmarked" : false,
        "jipipe:algorithm:pass-through" : false,
        "jipipe:node:name" : "Resolve Stitched Tile Grid",
