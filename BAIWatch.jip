      },
      "7fcdf524-63d3-4eb8-9681-cfff1959844f/column-t" : {
        "name" : "Column 'T'",
        "description" : "Table column that determines the frame location. For one-based positions, 0 indicates that the ROI is present in all frame-slices. For zero-based positions the value is -1 or lower.\n\nThis parameter can be used to either select an existing column from a table or to generate a new column by providing a value for each row.<ul><li>Selecting columns by exact name: Type in the name of the column into the value field. Quotation marks are optional.</li><li>Selecting columns by filtering: The value expression is called for each existing column and provided as variable 'value'. Return TRUE at any point to select the value. Example: <code>value == \"Mean\"</code></li><li>Generating columns: The value expression is called for each row. Return a string or number. You have access to the other column values inside the row (as variables). Example: <code>Mean + 0.5 * X</code>. If you do not provide a valid expression, the expression itself is put in as column value (string)</li></ul>"
      },
      "15900991-55ce-4bf3-a99e-336eaef81ff4/jipipe:data-batch-generation/limit" : {
        "name" : "Limit",
        "description" : "Limits which iteration steps are generated. The first index is zero."
      },
      "7fcdf524-63d3-4eb8-9681-cfff1959844f/column-z" : {
        "name" : "Column 'Z'",
        "description" : "Table column that determines the Z location. For one-based positions, 0 indicates that the ROI is present in all Z-slices. For zero-based positions the value is -1 or lower.\n\nThis parameter can be used to either select an existing column from a table or to generate a new column by providing a value for each row.<ul><li>Selecting columns by exact name: Type in the name of the column into the value field. Quotation marks are optional.</li><li>Selecting columns by filtering: The value expression is called for each existing column and provided as variable 'value'. Return TRUE at any point to select the value. Example: <code>value == \"Mean\"</code></li><li>Generating columns: The value expression is called for each row. Return a string or number. You have access to the other column values inside the row (as variables). Example: <code>Mean + 0.5 * X</code>. If you do not provide a valid expression, the expression itself is put in as column value (string)</li></ul>"
      },
      "e2dc7330-aa2c-4d0f-bc8f-1c8d385820ac/jipipe:local-parallelization-num-threads" : {
        "pinned" : true,
        "name" : "Local parallelization",
        "description" : "If enabled, override the partition- and run-wide parallelization settings and apply parallelization only on this node."
      },
      "489b2e52-a91f-4e0a-a784-ed55450698db/jipipe:environment-overrides/jipipe-python-adapter-library" : {
        "name" : "JIPipe Python adapter library",
        "description" : "Allows to override the JIPipe Python adapter library environment. Additional library for Python"
      },
      "8cb8f9b8-535b-4b3c-a2be-84543d6e7ffb/jipipe:data-batch-generation/annotation-matching-method" : {
        "name" : "Annotation matching method",
        "description" : "Allows to customize when two annotation sets are considered as equal. By default, non-empty annotation values should match exactly. You can also use a custom expression, instead."
      },
      "ef625091-0d1f-43d7-b859-0944b7ebfe2d/cleanup-afterwards" : {
        "name" : "Clean up data after processing",
        "description" : "If enabled, data is deleted from temporary directories after the processing was finished. Disable this to make it possible to debug your scripts. The directories are accessible via the logs (Tools &gt; Logs)."
      },
      "f3332d7b-8f63-4324-94dc-47a23443aab5/jipipe:parameter-slot-algorithm/attach-parameter-annotations" : {
        "name" : "Attach parameter annotations",
        "description" : "If multiple parameters are allowed, attach the parameter values as annotations."
      },
      "a960f8fd-1284-4f85-bed7-47b9741c2b1d/jipipe:algorithm:enabled" : {
        "pinned" : true,
        "name" : "Enabled",
        "description" : "If disabled, this algorithm will be skipped in a run. Please note that this will also disable all algorithms dependent on this algorithm."
      },
      "1a429057-a0e9-4f90-91a9-d445e6c2c675/jipipe:data-batch-generation/column-matching" : {
        "important" : true,
        "pinned" : true,
        "name" : "Grouping method",
        "description" : "Algorithms with multiple inputs require to match the incoming data to data sets. This allows you to determine how interesting data annotation columns are extracted from the incoming data. Union matches using the union of annotation columns. Intersection intersects the sets of available columns. You can also customize which columns should be included or excluded."
      },
      "c5911c97-77a8-40ca-b3a1-bc57d7ae7121/remove-output-annotations" : {
        "name" : "Remove output annotations",
        "description" : "If enabled, annotations are removed from the output."
      },
      "fbefb67d-ff2d-4717-a243-37440b7e10e6/recursive-follows-links" : {
        "name" : "Recursive search follows links",
        "description" : "If enabled, a recursive search follows symbolic links. (Only Windows) Please note that Windows does not create symbolic links by default."
