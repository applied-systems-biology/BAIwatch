        "jipipe:node:ui-locked" : false,
        "code" : {
          "code" : "\n\nselectWindow(\"Input\");\n\ncolumns = parseInt(getJIPipeAnnotation(\"NbTilesY\"));\nrows = parseInt(getJIPipeAnnotation(\"NbTilesX\"));\n\ntargetWidth = 4000;\n\n// ------------------------------------------------------------\n// 1. Create montage at original tile scale\n// ------------------------------------------------------------\nif (columns != 1 && rows != 1){\nrun(\"Make Montage...\", \"columns=\" + columns + \" rows=\" + rows + \" scale=1 border=0\");\n}\n// ------------------------------------------------------------\n// 2. Resize finished montage to exact width = 4000\n// ------------------------------------------------------------\n\ncurrentWidth = getWidth();\ncurrentHeight = getHeight();\n\nscaleFactor = targetWidth / currentWidth;\ntargetHeight = round(currentHeight * scaleFactor);\n\nrun(\"Size...\", \"width=\" + targetWidth + \" height=\" + targetHeight + \" interpolation=Bicubic\");\n\nrename(\"Output\");",
          "collapsed" : false
        },
