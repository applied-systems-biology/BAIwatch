            "0862e272-b9e0-430a-8065-8ced6e89518f" : {
              "jipipe:graph-compartment" : "",
              "jipipe:alias-id" : "fftconvolve",
              "jipipe:slot-configuration" : {
                "input" : {
                  "Input" : {
                    "slot-data-type" : "imagej-imgplus",
                    "slot-type" : "Input",
                    "name" : "Input",
                    "custom-name" : null,
                    "description" : "",
                    "is-virtual" : true,
                    "save-outputs" : true,
                    "is-optional" : false
                  },
                  "Input 1" : {
                    "slot-data-type" : "imagej-imgplus",
                    "slot-type" : "Input",
                    "name" : "Input 1",
                    "custom-name" : null,
                    "description" : "",
                    "is-virtual" : false,
                    "save-outputs" : true,
                    "is-optional" : false
                  }
                },
                "output" : {
                  "Table" : {
                    "slot-data-type" : "imagej-results-table",
                    "slot-type" : "Output",
                    "name" : "Table",
                    "custom-name" : null,
                    "description" : "",
                    "is-virtual" : false,
                    "save-outputs" : true,
                    "is-optional" : false
                  }
                }
              },
              "jipipe:metadata-v1" : {
                "location/_/y" : 24,
                "location/_/x" : 27
              },
              "jipipe:node-info-id" : "cpython-script-iterating",
              "annotation-merge-strategy" : "Merge",
              "jipipe:algorithm:enabled" : true,
              "jipipe:node:ui-locked" : false,
              "code" : {
                "code" : "from jipipe.imagej import *\nimport numpy as np\nimport pandas as pd\nfrom skimage.transform import resize\n\n# Load the image tiles and montage mask.\nds = jipipe_inputs[\"Input\"]\ntiles = np.asarray(load_image_file(data_slot=ds, row=0))\n\nds = jipipe_inputs[\"Input 1\"]\nmontage_mask = np.squeeze(load_image_file(data_slot=ds, row=0))\n\n# Read grid dimensions and calculate the expected tile count.\ntiles_x = int(float(jipipe_annotations[\"TilesX\"]))\ntiles_y = int(float(jipipe_annotations[\"TilesY\"]))\nexpected_z = tiles_x * tiles_y\n\n# Arrange tiles as a stack with the tile axis first.\nif tiles.ndim == 2:\n    tiles = tiles[np.newaxis, :, :]\nelif tiles.ndim == 3:\n    if tiles.shape[0] == expected_z:\n        pass\n    elif tiles.shape[-1] == expected_z:\n        tiles = np.moveaxis(tiles, -1, 0)\n    elif tiles.shape[1] == expected_z:\n        tiles = np.moveaxis(tiles, 1, 0)\n    else:\n        raise ValueError(f\"No axis matches expected Z={expected_z}. Shape: {tiles.shape}\")\nelse:\n    raise ValueError(f\"Tiles must be 2D or 3D. Got: {tiles.shape}\")\n\n# Validate the mask dimensions and tile count.\nif montage_mask.ndim != 2:\n    raise ValueError(f\"Montage mask must be 2D. Got: {montage_mask.shape}\")\n\nnumber_of_tiles, tile_height, tile_width = tiles.shape\n\nif number_of_tiles != expected_z:\n    raise ValueError(f\"Found {number_of_tiles} tiles, but expected {expected_z}\")\n\n# Divide the montage mask into tile regions.\nmask_height, mask_width = montage_mask.shape\n\nx_edges = np.linspace(0, mask_width, tiles_x + 1).round().astype(int)\ny_edges = np.linspace(0, mask_height, tiles_y + 1).round().astype(int)\n\n# Accumulate intensity statistics across all masked pixels.\npixel_count = 0\npixel_sum = 0.0\npixel_squared_sum = 0.0\n\nfor tile_index in range(number_of_tiles):\n    row = tile_index // tiles_x\n    column = tile_index % tiles_x\n\n    x_start = x_edges[column]\n    x_end = x_edges[column + 1]\n    y_start = y_edges[row]\n    y_end = y_edges[row + 1]\n\n    small_tile_mask = montage_mask[y_start:y_end, x_start:x_end]\n\n    # Resize the mask to the tile dimensions using nearest-neighbor interpolation.\n    binary_mask = resize(small_tile_mask, (tile_height, tile_width), order=0, preserve_range=True, anti_aliasing=False) > 0\n\n    masked_values = tiles[tile_index][binary_mask].astype(np.float64)\n\n    pixel_count += masked_values.size\n    pixel_sum += np.sum(masked_values)\n    pixel_squared_sum += np.sum(masked_values ** 2)\n\nif pixel_count == 0:\n    raise ValueError(\"The mask contains no valid pixels\")\n\n# Calculate the mean and population variance of the masked intensities.\nmean_intensity = pixel_sum / pixel_count\nvariance = pixel_squared_sum / pixel_count - mean_intensity ** 2\n\n# Prevent negative variance caused by floating-point rounding.\nvariance = max(variance, 0.0)\n\n# Define the threshold as the mean plus six standard deviations.\nstd_intensity = np.sqrt(variance)\ncoverage_threshold = mean_intensity + 6 * std_intensity\n\n# Output the intensity statistics and coverage threshold.\nresults = pd.DataFrame({\n    \"File\": [jipipe_annotations[\"#FILE\"]],\n    \"MeanIntensity\": [mean_intensity],\n    \"StandardDeviation\": [std_intensity],\n    \"CoverageThreshold\": [coverage_threshold]\n})\n\ndso = jipipe_outputs[\"Table\"]\nadd_table(results, dso)",
                "collapsed" : false
              },
              "suppress-logs" : false,
              "jipipe:node:bookmarked" : false,
              "jipipe:algorithm:pass-through" : false,
              "jipipe:node:name" : "FFTConvolve",
              "jipipe:algorithm:runtime-partition" : {
                "index" : 0
              },
              "jipipe:node:description" : "<html><head></head><body></body></html>",
              "external-code" : false,
              "cleanup-afterwards" : true,
              "jipipe:local-parallelization-num-threads" : {
                "content" : 1,
                "enabled" : false
              },
              "jipipe:algorithm:custom-expression-variables" : {
                "parameters" : { }
              },
              "jipipe:environment-overrides" : {
                "parameters" : {
                  "python" : {
                    "key" : "python",
                    "name" : "Python",
                    "description" : "Allows to override the Python environment. A Python environment",
                    "hidden" : false,
                    "field-class" : "org.hkijena.jipipe.plugins.python.OptionalPythonEnvironment",
                    "value" : {
                      "content" : {
                        "name" : "",
                        "version" : "unknown",
                        "source" : "NA",
                        "load-from-artifact" : false,
                        "artifact-query" : {
                          "query-v2" : "null"
                        },
                        "environment-type" : "System",
                        "arguments" : {
                          "expression" : "ARRAY(script_file)"
                        },
                        "executable-path" : ""
                      },
