      "9a6df0f2-b9cf-4738-82f8-f43b4ff8d0e3/jipipe:algorithm:runtime-partition" : {
        "pinned" : true,
        "name" : "Partition",
        "description" : "Allows to move the node into a different runtime partition, which determine how the workload is executed."
      },
      "e6f3b6c9-29c7-4f7f-a77a-5c224210751d/jipipe:data-batch-generation/column-matching" : {
        "important" : true,
        "pinned" : true,
        "name" : "Grouping method",
        "description" : "Algorithms with multiple inputs require to match the incoming data to data sets. This allows you to determine how interesting data annotation columns are extracted from the incoming data. Union matches using the union of annotation columns. Intersection intersects the sets of available columns. You can also customize which columns should be included or excluded."
      },
      "bda73edd-8174-40c1-855f-95ddfbe6b5ca/project-overview-color" : {
        "name" : "Project overview color",
        "description" : "Allows to mark outputs of this compartment with a color in the project overview."
      },
      "f32f3a0c-bcb5-469c-8299-453c087df7b4/key" : {
        "important" : true,
        "name" : "Project user directory key",
        "description" : "The key of the project user directory. You can configure directories by navigating to Project > Project settings > User directories (or alternatively to Project > Project overview > User directories)"
      },
      "f32f3a0c-bcb5-469c-8299-453c087df7b4/jipipe:parameter-slot-algorithm/has-parameter-slot" : {
        "name" : "Multiple parameters",
        "description" : "If enabled, there will be an additional slot that consumes parameter data sets. The algorithm then will be applied for each of this parameter sets."
      },
      "91c30daf-4535-4fab-a66a-e9a3d6f632db/jipipe:parameter-slot-algorithm/attach-only-non-default-parameter-annotations" : {
