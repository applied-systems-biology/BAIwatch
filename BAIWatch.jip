      "e2c565d9-b418-43e8-b027-b585011de631" : {
        "jipipe:graph-compartment" : "7950851b-ccdb-446f-961f-3cc28fe8814d",
        "jipipe:alias-id" : "stitching-ii-1",
        "jipipe:slot-configuration" : {
          "input" : {
            "Input" : {
              "slot-data-type" : "imagej-imgplus",
              "slot-type" : "Input",
              "name" : "Input",
              "custom-name" : null,
              "description" : "",
              "is-virtual" : false,
              "save-outputs" : true,
              "is-optional" : false
            }
          },
          "output" : {
            "Output" : {
              "slot-data-type" : "imagej-imgplus",
              "slot-type" : "Output",
              "name" : "Output",
              "custom-name" : null,
              "description" : "",
              "is-virtual" : false,
              "save-outputs" : true,
              "is-optional" : false
            }
          }
        },
        "jipipe:metadata-v1" : {
          "location/7950851b-ccdb-446f-961f-3cc28fe8814d/y" : 11,
          "location/_/y" : 11,
          "location/7950851b-ccdb-446f-961f-3cc28fe8814d/x" : 1,
          "location/_/x" : 1
        },
        "jipipe:node-info-id" : "external-imagej-macro",
        "export-delay" : 250,
        "jipipe:algorithm:enabled" : true,
        "jipipe:node:ui-locked" : false,
        "code" : {
          "code" : "// Select input image\nselectWindow(\"Input\");\n\n// Read JIPipe annotations\nfile         = getJIPipeAnnotation(\"#FullPathWithoutExtension\");\ngrid_size_x  = getJIPipeAnnotation(\"TilesX\");\ngrid_size_y  = getJIPipeAnnotation(\"TilesY\");\ntile_overlap = getJIPipeAnnotation(\"OverlapX\");\nInputMode    = getJIPipeAnnotation(\"InputMode\");\nStitching    = getJIPipeAnnotation(\"Stitching\");\n\n// Use the parent directory for unstitched input\nif (toLowerCase(InputMode) == \"unstitched\")\n    file = File.getParent(file);\n\n// Folder containing tiles to stitch\nINPUT = file + \"/to_stitch\";\n\n\n// Store current stack depth\ncurrentDepth = nSlices;\n\n\n// Perform stitching if requested\nif (Stitching == \"true\") {\n\n    run(\n        \"Grid/Collection stitching\",\n        \"type=[Grid: row-by-row] \" +\n        \"order=[Right & Down                ] \" +\n        \"grid_size_x=\" + grid_size_x + \" \" +\n        \"grid_size_y=\" + grid_size_y + \" \" +\n        \"tile_overlap=\" + tile_overlap + \" \" +\n        \"first_file_index_i=0 \" +\n        \"directory=\" + INPUT + \" \" +\n        \"file_names={iiii}.tif \" +\n        \"output_textfile_name=TileConfiguration.txt \" +\n        \"fusion_method=[Linear Blending] \" +\n        \"regression_threshold=0.30 \" +\n        \"max/avg_displacement_threshold=2.50 \" +\n        \"absolute_displacement_threshold=3.50 \" +\n        \"computation_parameters=[Save memory (but be slower)] \" +\n        \"image_output=[Fuse and display]\"\n    );\n\n    // Apply grayscale LUT\n    run(\"Grays\");\n\n    // Rename stitched image\n    rename(\"Output\");\n\n} else {\n\n    // No stitching: return input image\n    selectWindow(\"Input\");\n    rename(\"Output\");\n}",
          "collapsed" : false
        },
        "import-delay" : 1000,
        "jipipe:node:bookmarked" : false,
        "jipipe:algorithm:pass-through" : false,
        "jipipe:node:name" : "Stitch tiles",
        "jipipe:algorithm:runtime-partition" : {
          "index" : 1
        },
        "jipipe:node:description" : "<html><head></head><body></body></html>",
        "external-code" : false,
        "jipipe:local-parallelization-num-threads" : {
          "content" : 1,
          "enabled" : false
        },
        "input-to-imagej-exporters/Input" : {
