        "jipipe:node-info-id" : "cpython-script-iterating",
        "annotation-merge-strategy" : "Merge",
        "jipipe:algorithm:enabled" : true,
        "jipipe:node:ui-locked" : false,
        "code" : {
          "code" : "from jipipe.imagej import *\nfrom pathlib import Path\nimport shutil\nimport os\nimport stat\n\n# Load the input stack.\nds = jipipe_inputs[\"Input\"]\nstack = load_image_file(data_slot=ds, row=0)\n\n# Locate the stitching folder.\nbase_path = Path(jipipe_annotations[\"#FullPathWithoutExtension\"])\ninput_mode = jipipe_annotations[\"InputMode\"].strip().lower()\n\nif input_mode == \"unstitched\":\n    folder = base_path.parent / \"to_stitch\"\nelse:\n    folder = base_path / \"to_stitch\"\n\n# Retry removal if a file is read-only.\ndef on_rm_error(func, path, exc_info):\n    os.chmod(path, stat.S_IWRITE)\n    func(path)\n\n# Remove the folder and its contents.\nif jipipe_annotations[\"Stitching\"] == \"true\" and folder.exists():\n    shutil.rmtree(folder, onerror=on_rm_error)\n    \n\ndso = jipipe_outputs[\"Output\"]\nadd_image(stack, dso)",
          "collapsed" : false
        },
        "suppress-logs" : false,
