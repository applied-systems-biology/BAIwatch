      "15705777-1c2f-4d4b-8091-fdcae68f8c48" : {
        "jipipe:graph-compartment" : "c6d5c5ef-c1d5-4ee1-9d93-76c60bdf7211",
        "jipipe:alias-id" : "compute-correlation-map",
        "jipipe:slot-configuration" : {
          "input" : {
            "Input" : {
              "slot-data-type" : "imagej-imgplus",
              "slot-type" : "Input",
              "name" : "Input",
