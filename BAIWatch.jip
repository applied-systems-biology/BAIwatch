          "code" : "selectWindow(\"Input\");\n\n// Read parameters and remove annotation brackets.\nnegativeControl = getJIPipeAnnotation(\"nameOfNegativeControl\");\ncoverageThreshold = getJIPipeAnnotation(\"CoverageThreshold\");\n\nnegativeControl = toLowerCase(trim(replace(replace(negativeControl, \"[\", \"\"), \"]\", \"\")));\ncoverageThreshold = toLowerCase(trim(replace(replace(coverageThreshold, \"[\", \"\"), \"]\", \"\")));\n\n// Identify missing values.\nnegativeMissing = 0;\nthresholdMissing = 0;\n\nif (negativeControl == \"\" || negativeControl == \"none\" || negativeControl == \"null\" || negativeControl == \"nan\") negativeMissing = 1;\nif (coverageThreshold == \"\" || coverageThreshold == \"none\" || coverageThreshold == \"null\" || coverageThreshold == \"nan\") thresholdMissing = 1;\n\n// Require exactly one threshold source.\nif (negativeMissing == 1 && thresholdMissing == 1) {\n    exit(\"Missing threshold source: specify a negative control image name or a manual coverage threshold.\");\n}\n\nif (negativeMissing == 0 && thresholdMissing == 0) {\n    exit(\"Conflicting threshold sources: specify either a negative control image name or a manual coverage threshold, not both.\");\n}\n\n// Check that the specified negative control file exists.\nif (negativeMissing == 0) {\n    // Preserve the original filename capitalization.\n    negativeName = getJIPipeAnnotation(\"nameOfNegativeControl\");\n    negativeName = trim(replace(replace(negativeName, \"[\", \"\"), \"]\", \"\"));\n\n    // Use the input directory, or the parent directory of the input file.\n    inputPath = getJIPipeAnnotation(\"#FullPath\");\n    inputFolder = inputPath;\n    if (!File.isDirectory(inputPath)) inputFolder = File.getParent(inputPath);\n\n    negativePath = inputFolder ; // + \"/\" + negativeName;\n\n    if (!File.exists(negativePath)) {\n        exit(\"Negative control file not found:\\n\" + negativePath);\n    }\n\n\n}\n\n\nparameters = newArray(\n    \"MaxBlockPixels\", \"CoverageThreshold\", \"Scale\", \"Radius\", \"Resolution\",\n    \"C\", \"Z\", \"T\", \"TilesX\", \"TilesY\",\n    \"TileWidth\", \"TileHeight\", \"OverlapX\", \"OverlapY\"\n);\n\nfor (i = 0; i < parameters.length; i++) {\n    value = getJIPipeAnnotation(parameters[i]);\n    value = toLowerCase(trim(replace(replace(value, \"[\", \"\"), \"]\", \"\")));\n\n    // Validate only nonempty values.\n    if (value != \"\" && value != \"none\" && value != \"null\" && value != \"nan\") {\n        if (isNaN(parseFloat(value))) {\n            exit(parameters[i] + \" must be a number. Received: \" + value);\n        }\n    }\n}\n\n\napplyBaSiC = toLowerCase(getJIPipeAnnotation(\"ApplyBaSiC\"));\nstitching = toLowerCase(getJIPipeAnnotation(\"Stitching\"));\n\ntilesX = parseFloat(getJIPipeAnnotation(\"TilesX\"));\ntilesY = parseFloat(getJIPipeAnnotation(\"TilesY\"));\n\noverlapX = parseFloat(getJIPipeAnnotation(\"OverlapX\"));\noverlapY = parseFloat(getJIPipeAnnotation(\"OverlapY\"));\n\n// BaSiC and stitching require more than one tile.\nif (applyBaSiC == \"true\" || stitching == \"true\") {\n    if (isNaN(tilesX) || isNaN(tilesY)) {\n        exit(\"TilesX and TilesY are required when BaSiC or stitching is enabled.\");\n    }\n\n    if (tilesX == 1 && tilesY == 1) {\n        exit(\"Disable BaSiC and stitching for a single tile (TilesX = TilesY = 1).\");\n    }\n}\n\n// Stitching requires nonzero overlap in both directions.\nif (stitching == \"true\") {\n    if (isNaN(overlapX) || isNaN(overlapY)) {\n        exit(\"OverlapX and OverlapY are required when stitching is enabled.\");\n    }\n\n    if (overlapX == 0 && overlapY == 0) {\n    exit(\"Stitching requires at least one nonzero overlap: OverlapX or OverlapY.\");\n}\n}\n\n\n\ninputMode = toLowerCase(trim(getJIPipeAnnotation(\"InputMode\")));\n\nif (inputMode == \"unstitched\") {\n    parameters = newArray(\n        \"TilesX\", \"TilesY\", \"OverlapX\", \"OverlapY\", \"TileScanOrder\"\n    );\n\n    for (i = 0; i < parameters.length; i++) {\n        value = getJIPipeAnnotation(parameters[i]);\n        value = toLowerCase(trim(replace(replace(value, \"[\", \"\"), \"]\", \"\")));\n\n        if (value == \"\" || value == \"none\" || value == \"null\" || value == \"nan\") {\n            exit(parameters[i] + \" must be specified when InputMode is unstitched.\");\n        }\n    }\n}\nrename(\"Output\");",
