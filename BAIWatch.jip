        },
        "jipipe:metadata-v1" : {
          "location/_/y" : 33,
          "location/_/x" : 5,
          "location/c6d5c5ef-c1d5-4ee1-9d93-76c60bdf7211/x" : 8,
          "location/c6d5c5ef-c1d5-4ee1-9d93-76c60bdf7211/y" : 82
        },
        "jipipe:node-info-id" : "cpython-script-iterating",
        "annotation-merge-strategy" : "Merge",
        "jipipe:algorithm:enabled" : true,
        "jipipe:node:ui-locked" : false,
        "code" : {
          "code" : "from jipipe.imagej import *\nimport numpy as np\nimport pandas as pd\n\n# Load the binary disk mask.\nds = jipipe_inputs[\"Input\"]\nmask = np.asarray(load_image_file(data_slot=ds, row=0)) > 0\n\n# Read grid dimensions.\ntiles_x = int(float(jipipe_annotations[\"TilesX\"]))\ntiles_y = int(float(jipipe_annotations[\"TilesY\"]))\n\nif mask.ndim != 2:\n    raise ValueError(\"Mask must be 2D.\")\n\nif tiles_x < 1 or tiles_y < 1:\n    raise ValueError(\"Tile counts must be positive.\")\n\n# Calculate tile dimensions.\nheight, width = mask.shape\ntile_height = height // tiles_y\ntile_width = width // tiles_x\n\nif tile_height == 0 or tile_width == 0:\n    raise ValueError(\"Tile dimensions must be greater than zero.\")\n\n# Collect 1-based numbers of tiles fully inside the disk.\nvalid_numbers = []\n\nfor row in range(tiles_y):\n    for column in range(tiles_x):\n        tile_mask = mask[\n            row * tile_height:(row + 1) * tile_height,\n            column * tile_width:(column + 1) * tile_width\n        ]\n\n        if np.all(tile_mask):\n            valid_numbers.append(row * tiles_x + column + 1)\n\n# Output the selected tile numbers.\nresults = pd.DataFrame({\"TileNumber\": valid_numbers})\n\nannotations = {\"TileNumbers\": str(valid_numbers)}\n\n\n \n \n \ndso = jipipe_outputs[\"Output\"]\nadd_table(results, dso,text_annotations=annotations)",
          "collapsed" : false
        },
        "suppress-logs" : false,
        "jipipe:node:bookmarked" : false,
        "jipipe:algorithm:pass-through" : false,
        "jipipe:node:name" : "Find empty tiles",
        "jipipe:algorithm:runtime-partition" : {
          "index" : 1
        },
        "jipipe:node:description" : "<html><head></head><body></body></html>",
        "external-code" : false,
        "cleanup-afterwards" : true,
