    "global-parameters" : {
      "parameters" : {
        "InputMode" : {
          "key" : "InputMode",
          "name" : "1 - Input mode (stitched or unstitched)",
          "description" : "Select whether the input is a <strong data-start=\"30\" data-end=\"48\">stitched \n    image</strong> or a <strong data-start=\"54\" data-end=\"84\">folder of \n    unstitched tiles</strong>. Tile filenames must include numbers that order \n    the tiles according to their acquisition sequence, using either raster or \n    serpentine scanning.",
          "hidden" : false,
          "field-class" : "java.lang.String",
          "value" : "unstitched",
          "short-key" : "InputMode",
          "ui-order" : 0,
          "field-class-id" : "string"
        },
        "Scale" : {
          "key" : "Scale",
          "name" : "9.1 - Image downscaling factor",
          "description" : "Scaling factor applied during tile reconstruction. A value of 1 preserves \n    the original tile dimensions.",
          "hidden" : false,
          "field-class" : "java.lang.String",
          "value" : "0.1",
          "short-key" : "Scale",
          "ui-order" : 0,
          "field-class-id" : "string"
        },
        "MaxBlockPixels" : {
          "key" : "MaxBlockPixels",
          "name" : "9.2 - Maximum pixels per import block",
          "description" : "<p>\n      Maximum number of pixels imported as a single rectangular block, \n      enabling memory-safe processing of very large stitched images.\n    </p>",
          "hidden" : false,
          "field-class" : "java.lang.String",
          "value" : "250000000",
          "short-key" : "MaxBlockPixels",
          "ui-order" : 0,
          "field-class-id" : "string"
        },
        "Radius" : {
          "key" : "Radius",
          "name" : "3.1 - Disk radius (mm)",
          "description" : "<p>\n      Radius of the disk in mm.\n    </p>",
          "hidden" : false,
          "field-class" : "java.lang.String",
          "value" : "14",
          "short-key" : "Radius",
          "ui-order" : 0,
          "field-class-id" : "string"
        },
        "Resolution" : {
          "key" : "Resolution",
          "name" : "3.2 - Resolution (nm/pixel)",
          "description" : "<p>\n      To deduce the disc radius in pixels.\n    </p>",
          "hidden" : false,
          "field-class" : "java.lang.String",
          "value" : "345",
          "short-key" : "Resolution",
          "ui-order" : 0,
          "field-class-id" : "string"
        },
        "CoverageThreshold" : {
          "key" : "CoverageThreshold",
          "name" : "2.2 - Manual coverage threshold (set if there is no negative control image)",
          "description" : "<p>\n      Intensity threshold used to classify pixels as fluorescence-positive \n      during surface-coverage quantification.\n    </p>",
          "hidden" : false,
          "field-class" : "java.lang.String",
          "value" : "162",
          "short-key" : "CoverageThreshold",
          "ui-order" : 0,
          "field-class-id" : "string"
        },
        "ApplyBaSiC" : {
          "key" : "ApplyBaSiC",
          "name" : "Apply BaSiC illumination correction",
          "description" : "<p>\n      Boolean if True and the number of tiles is more or equal than two, the \n      pipeline corrects the illumination.\n    </p>",
          "hidden" : false,
          "field-class" : "java.lang.Boolean",
          "value" : true,
          "short-key" : "ApplyBaSiC",
          "ui-order" : 0,
          "field-class-id" : "boolean"
        },
        "TileWidth" : {
          "key" : "TileWidth",
          "name" : "6.1 - Tile width in px (for stitched datasets)",
          "description" : "<p>\n      Width of each reconstructed tile (pixels).\n    </p>",
          "hidden" : false,
          "field-class" : "java.lang.String",
          "value" : "",
          "short-key" : "TileWidth",
          "ui-order" : 0,
          "field-class-id" : "string"
        },
        "TileHeight" : {
          "key" : "TileHeight",
          "name" : "6.2 - Tile height in px (for stitched datasets)",
          "description" : "<p>\n      Height of each reconstructed tile (pixels).\n    </p>",
          "hidden" : false,
          "field-class" : "java.lang.String",
          "value" : "",
          "short-key" : "TileHeight",
          "ui-order" : 0,
          "field-class-id" : "string"
        },
        "TilesX" : {
          "key" : "TilesX",
          "name" : "7.1 - Number of tile columns (for unstitched datasets)",
          "description" : "<p>\n      Number of tiles in the horizontal direction.\n    </p>",
          "hidden" : false,
          "field-class" : "java.lang.String",
          "value" : "23",
          "short-key" : "TilesX",
          "ui-order" : 0,
          "field-class-id" : "string"
        },
        "TilesY" : {
          "key" : "TilesY",
          "name" : "7.2 - Number of tile rows (for unstitched datasets)",
          "description" : "<p>\n      Number of tiles in the vertical direction.\n    </p>",
          "hidden" : false,
          "field-class" : "java.lang.String",
          "value" : "23",
          "short-key" : "TilesY",
          "ui-order" : 0,
          "field-class-id" : "string"
        },
        "OverlapX" : {
          "key" : "OverlapX",
          "name" : "8.1 - Horizontal tile overlap % (for unstitched datasets)",
          "description" : "<p>\n      Horizontal overlap between adjacent tiles.\n    </p>",
          "hidden" : false,
          "field-class" : "java.lang.String",
          "value" : "10",
          "short-key" : "OverlapX",
          "ui-order" : 0,
          "field-class-id" : "string"
        },
        "OverlapY" : {
          "key" : "OverlapY",
          "name" : "8.2 - Vertical tile overlap %  (for unstitched datasets)",
          "description" : "<p>\n      Vertical overlap between adjacent tiles.\n    </p>",
          "hidden" : false,
          "field-class" : "java.lang.String",
          "value" : "10",
          "short-key" : "OverlapY",
          "ui-order" : 0,
          "field-class-id" : "string"
        },
        "TileScanOrder" : {
          "key" : "TileScanOrder",
          "name" : "9.3 -Tile acquisition order (for unstitched datasets)",
          "description" : "<p>\n      Defines the acquisition order of unstitched image tiles. <code data-start=\"530\" data-end=\"538\">Raster</code> \n      indicates that all rows are acquired in the same direction, whereas <code data-start=\"607\" data-end=\"619\">Serpentine</code> \n      indicates alternating acquisition directions between successive rows.\n    </p>",
          "hidden" : false,
          "field-class" : "java.lang.String",
          "value" : "Raster",
          "short-key" : "TileScanOrder",
          "ui-order" : 0,
          "field-class-id" : "string"
        },
        "StackOrder" : {
          "key" : "StackOrder",
          "name" : "5 - Stack dimension order",
          "description" : "<p>\n      Specifies the dimension ordering: X and Y are spatial dimensions,  C = \n      channel, Z = 3D slice, and T = time.\n    </p>",
          "hidden" : false,
          "field-class" : "java.lang.String",
          "value" : "XYCZT",
          "short-key" : "StackOrder",
          "ui-order" : 0,
          "field-class-id" : "string"
        },
        "C" : {
          "key" : "C",
          "name" : "4.1 - Channel (C)",
          "description" : "<p>\n      Number of the channel to analyse.\n    </p>",
          "hidden" : false,
          "field-class" : "java.lang.String",
          "value" : "1",
          "short-key" : "C",
          "ui-order" : 0,
          "field-class-id" : "string"
        },
        "Z" : {
          "key" : "Z",
          "name" : "4.2 - Z-slice (Z)",
          "description" : "Slice to analyse.",
          "hidden" : false,
          "field-class" : "java.lang.String",
          "value" : "1",
          "short-key" : "Z",
          "ui-order" : 0,
          "field-class-id" : "string"
        },
        "T" : {
          "key" : "T",
          "name" : "4.3 - Time point (T)",
          "description" : "<p>\n      Timepoint to analyse.\n    </p>",
          "hidden" : false,
          "field-class" : "java.lang.String",
          "value" : "1",
          "short-key" : "T",
          "ui-order" : 0,
          "field-class-id" : "string"
        },
        "Stitching" : {
          "key" : "Stitching",
          "name" : "Stitch tiles",
          "description" : "",
          "hidden" : false,
          "field-class" : "java.lang.Boolean",
          "value" : true,
          "short-key" : "Stitching",
          "ui-order" : 0,
          "field-class-id" : "boolean"
        },
        "nameOfNegativeControl" : {
          "key" : "nameOfNegativeControl",
          "name" : "2.1 - Negative control image name",
          "description" : "<p>\n      The negative control image can set the segmentation threshold \n      automatically. If the input mode is stitched include the extention (e.g \n      control.tif). If the input mode is unstitched write the name of the \n      folder containing the tiles of the negative control image\n    </p>",
          "hidden" : false,
          "field-class" : "java.lang.String",
          "value" : "",
          "short-key" : "nameOfNegativeControl",
          "ui-order" : 0,
          "field-class-id" : "string"
        }
      }
    },
