      "a960f8fd-1284-4f85-bed7-47b9741c2b1d" : {
        "jipipe:graph-compartment" : "c6d5c5ef-c1d5-4ee1-9d93-76c60bdf7211",
        "jipipe:alias-id" : "ring-kernel-1",
        "jipipe:slot-configuration" : {
          "input" : {
            "Input" : {
              "slot-data-type" : "imagej-imgplus",
              "slot-type" : "Input",
              "name" : "Input",
              "custom-name" : null,
              "description" : "",
              "is-virtual" : true,
              "save-outputs" : true,
              "is-optional" : false
            }
          },
          "output" : {
            "Output" : {
              "slot-data-type" : "imagej-imgplus",
              "slot-type" : "Output",
              "name" : "Output",
              "custom-name" : null,
              "description" : "",
              "is-virtual" : true,
              "save-outputs" : true,
              "is-optional" : false
            }
          }
        },
        "jipipe:metadata-v1" : {
          "location/_/y" : 31,
          "location/_/x" : 52,
          "location/c6d5c5ef-c1d5-4ee1-9d93-76c60bdf7211/x" : 10,
          "location/c6d5c5ef-c1d5-4ee1-9d93-76c60bdf7211/y" : 21
        },
        "jipipe:node-info-id" : "external-imagej-macro",
        "export-delay" : 250,
        "jipipe:algorithm:enabled" : true,
        "jipipe:node:ui-locked" : false,
        "code" : {
          "code" : "selectWindow(\"Input\");\n\n// Define the ring radius and half-width in pixels.\nR = parseInt(getJIPipeAnnotation(\"Radius\")) / 2;\nring_w = 30;\n\n// Create the kernel image.\nkSize = 2 * (R + ring_w) + 1;\nnewImage(\"RingKernel\", \"32-bit black\", kSize, kSize, 1);\nselectWindow(\"RingKernel\");\n\nkc = floor(kSize / 2);\n\n// Set pixels within the ring to 1 and all other pixels to 0.\nsum = 0;\n\nfor (y = 0; y < kSize; y++) {\n    dy = y - kc;\n\n    for (x = 0; x < kSize; x++) {\n        dx = x - kc;\n        rr = sqrt(dx * dx + dy * dy);\n\n        v = 0;\n        if (abs(rr - R) <= ring_w) v = 1;\n\n        setPixel(x, y, v);\n        sum += v;\n    }\n}\n\nrename(\"Output\");",
          "collapsed" : false
        },
        "import-delay" : 1000,
        "jipipe:node:bookmarked" : false,
        "jipipe:algorithm:pass-through" : false,
        "jipipe:node:name" : "Create ring kernel",
        "jipipe:algorithm:runtime-partition" : {
          "index" : 1
        },
        "jipipe:node:description" : "<html><head></head><body></body></html>",
        "external-code" : false,
