        "jipipe:node-info-id" : "cpython-script-iterating",
        "annotation-merge-strategy" : "Merge",
        "jipipe:algorithm:enabled" : true,
        "jipipe:node:ui-locked" : false,
        "code" : {
          "code" : "from jipipe.imagej import *\nfrom pathlib import Path\n\n# Load the input image and table.\nds = jipipe_inputs[\"Input\"]\nimg = load_image_file(data_slot=ds, row=0)\n\nds = jipipe_inputs[\"Input 1\"]\ntable = load_table_file(data_slot=ds, row=0)\n\n# Check whether the corresponding ROI ZIP file exists.\nroiPath = jipipe_annotations[\"#FullPathWithoutExtension\"] + \".zip\"\nroi_path = Path(roiPath)\n\n# Route the image according to ROI file availability.\nif roi_path.exists():\n    dso = jipipe_outputs[\"Output\"]\n    add_image(img, dso)\nelse:\n    dso = jipipe_outputs[\"Output 1\"]\n    add_image(img, dso)",
          "collapsed" : false
        },
        "suppress-logs" : false,
        "jipipe:node:bookmarked" : false,
        "jipipe:algorithm:pass-through" : false,
        "jipipe:node:name" : "Route image by disk roi availability",
