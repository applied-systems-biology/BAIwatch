      "b8e297ca-133c-4dc9-bdaa-dbe1a51930b9/show-in-project-overview" : {
        "name" : "Show in project overview",
        "description" : "If enabled, show this output in the project overview. Please note that this setting has no effect if 'Show in project overview' on the compartment itself."
