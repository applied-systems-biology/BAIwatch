      "8f451181-7b11-4990-a29e-d2963702be79/recursive-follows-links" : {
        "name" : "Recursive search follows links",
        "description" : "If enabled, a recursive search follows symbolic links. (Only Windows) Please note that Windows does not create symbolic links by default."
