        "jipipe:metadata-v1" : {
          "location/_/y" : 32,
          "location/999c9b80-1dfc-453a-b7c1-d9fabe699cfb/x" : 3,
          "location/_/x" : 7,
          "location/999c9b80-1dfc-453a-b7c1-d9fabe699cfb/y" : 25
        },
        "jipipe:node-info-id" : "modify-annotation-script",
        "jipipe:algorithm:enabled" : true,
        "jipipe:node:ui-locked" : false,
        "code" : {
          "code" : "from datetime import datetime\n\n# Remove brackets from all non-Boolean parameters.\n\nstring_columns = [\n    \"MaxBlockPixels\", \"CoverageThreshold\", \"C\", \"Z\", \"T\",\n    \"Scale\", \"Radius\", \"Resolution\", \"InputMode\", \"TileScanOrder\",\n    \"StackOrder\", \"TilesX\", \"TilesY\", \"TileWidth\", \"TileHeight\",\n    \"OverlapX\", \"OverlapY\", \"nameOfNegativeControl\"\n]\n\nfor col in string_columns:\n    annotations[col] = str(annotations[col]).strip(\"[]\")\n\nannotations[\"InputMode\"] = annotations[\"InputMode\"].lower()\n\n# Convert Boolean parameters.\nif annotations[\"ApplyBaSiC\"] == \"[false]\":\n    annotations[\"ApplyBaSiC\"] = False\nif annotations[\"ApplyBaSiC\"] == \"[true]\":\n    annotations[\"ApplyBaSiC\"] = True\n\nif annotations[\"Stitching\"] == \"[false]\":\n    annotations[\"Stitching\"] = False\nif annotations[\"Stitching\"] == \"[true]\":\n    annotations[\"Stitching\"] = True\n    \n\n\ndate_time = datetime.now().strftime(\"%Y%m%d-%H%M\")\n\nannotations[\"DATETIME\"] = date_time",
          "collapsed" : false
        },
        "jipipe:node:bookmarked" : false,
        "jipipe:algorithm:pass-through" : false,
        "jipipe:node:name" : "Parse global parameters",
        "jipipe:algorithm:runtime-partition" : {
          "index" : 0
        },
        "jipipe:node:description" : "<html><head></head><body></body></html>",
        "jipipe:local-parallelization-num-threads" : {
