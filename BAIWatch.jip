      "3b0da9be-54a8-4442-91c6-cb87429a2f42" : {
        "jipipe:graph-compartment" : "999c9b80-1dfc-453a-b7c1-d9fabe699cfb",
        "jipipe:alias-id" : "resize-image-to-width-4000",
        "jipipe:slot-configuration" : {
          "input" : {
            "Input" : {
              "slot-data-type" : "imagej-imgplus",
              "slot-type" : "Input",
              "name" : "Input",
              "custom-name" : null,
              "description" : "",
              "is-virtual" : true,
              "save-outputs" : true,
              "is-optional" : false
            }
          },
          "output" : {
            "Output" : {
              "slot-data-type" : "imagej-imgplus",
              "slot-type" : "Output",
              "name" : "Output",
              "custom-name" : null,
              "description" : "",
              "is-virtual" : true,
              "save-outputs" : true,
              "is-optional" : false
            }
          }
        },
        "jipipe:metadata-v1" : {
          "location/_/y" : 89,
          "location/999c9b80-1dfc-453a-b7c1-d9fabe699cfb/x" : 13,
          "location/_/x" : 16,
          "location/999c9b80-1dfc-453a-b7c1-d9fabe699cfb/y" : 91
        },
        "jipipe:node-info-id" : "external-imagej-macro",
        "export-delay" : 250,
        "jipipe:algorithm:enabled" : true,
        "jipipe:node:ui-locked" : false,
        "code" : {
          "code" : "selectWindow(\"Input\");\n\n// Read the montage grid dimensions.\ncolumns = parseInt(getJIPipeAnnotation(\"TilesY\"));\nrows = parseInt(getJIPipeAnnotation(\"TilesX\"));\n\ntargetWidth = 4000;\n\n// Create a montage if the input contains multiple slices.\nif (nSlices > 1) {\n    w = getWidth();\n    h = getHeight();\n\n    // Check whether overlap values are missing or nonnumeric.\n    tilesXMissing = isNaN(parseFloat(getJIPipeAnnotation(\"OverlapX\")));\n    tilesYMissing = isNaN(parseFloat(getJIPipeAnnotation(\"OverlapY\")));\n\n    // Convert overlap percentages to pixels and crop the tiles.\n    if (!tilesXMissing && !tilesYMissing) {\n        OverlapX = w * parseFloat(getJIPipeAnnotation(\"OverlapX\")) / 100;\n        OverlapY = h * parseFloat(getJIPipeAnnotation(\"OverlapY\")) / 100;\n        makeRectangle(0, 0, w - OverlapX, h - OverlapY);\n        run(\"Crop\");\n    }\n\n    run(\"Make Montage...\", \"columns=\" + columns + \" rows=\" + rows + \" scale=1 border=0\");\n}\n\n// Calculate the target height to preserve the aspect ratio.\ncurrentWidth = getWidth();\ncurrentHeight = getHeight();\n\nscaleFactor = targetWidth / currentWidth;\ntargetHeight = round(currentHeight * scaleFactor);\n\n// Resize to exactly 4000 pixels wide.\nrun(\"Size...\", \"width=\" + targetWidth + \" height=\" + targetHeight + \" interpolation=Bicubic\");\n\nrename(\"Output\");",
          "collapsed" : false
        },
        "import-delay" : 1000,
        "jipipe:node:bookmarked" : false,
        "jipipe:algorithm:pass-through" : false,
        "jipipe:node:name" : "Resize Image to width 4000 ",
        "jipipe:algorithm:runtime-partition" : {
          "index" : 1
        },
        "jipipe:node:description" : "<html><head></head><body></body></html>",
        "external-code" : false,
        "jipipe:local-parallelization-num-threads" : {
          "content" : 1,
          "enabled" : false
        },
