        },
        "jipipe:metadata-v1" : {
          "location/_/y" : 44,
          "location/_/x" : 43,
          "location/c6d5c5ef-c1d5-4ee1-9d93-76c60bdf7211/x" : 2,
          "location/c6d5c5ef-c1d5-4ee1-9d93-76c60bdf7211/y" : 33
        },
        "jipipe:node-info-id" : "cpython-script-iterating",
        "annotation-merge-strategy" : "Merge",
        "jipipe:algorithm:enabled" : true,
        "jipipe:node:ui-locked" : false,
        "code" : {
          "code" : "from jipipe.imagej import *\nfrom scipy.signal import fftconvolve\n\n# Load the gradient magnitude image.\nds = jipipe_inputs[\"Input\"]\nGmag = load_image_file(data_slot=ds, row=0)\n\n# Load the template kernel.\nds = jipipe_inputs[\"Input 1\"]\nK = load_image_file(data_slot=ds, row=0)\n\n# Correlate the image with the template, preserving the image dimensions.\nC = fftconvolve(Gmag, K[::-1, ::-1], mode=\"same\")\n\n# Output the correlation image.\ndso = jipipe_outputs[\"Output\"]\nadd_image(C, dso)",
          "collapsed" : false
        },
        "suppress-logs" : false,
        "jipipe:node:bookmarked" : false,
        "jipipe:algorithm:pass-through" : false,
        "jipipe:node:name" : "Compute correlation map",
