      },
      "7fcdf524-63d3-4eb8-9681-cfff1959844f/jipipe:algorithm:enabled" : {
        "pinned" : true,
        "name" : "Enabled",
        "description" : "If disabled, this algorithm will be skipped in a run. Please note that this will also disable all algorithms dependent on this algorithm."
      },
      "b8e297ca-133c-4dc9-bdaa-dbe1a51930b9/jipipe:node:ui-locked" : {
        "pinned" : true,
        "hidden" : true,
        "name" : "Lock location/size",
        "description" : "If enabled, lock the location and size of this node. Does not affect automated alignment operations. Will lock the size if the node supports a resize handle. Will prevent deletion of the node by the user. Slots can still be edited/connected and parameters can still be changed."
      },
      "3b0da9be-54a8-4442-91c6-cb87429a2f42/jipipe:adaptive-parameters/enabled" : {
        "name" : "Enable adaptive parameters",
        "description" : "If enabled, you can use custom expressions to generate parameters. Please note that this will disable parallelization."
      },
      "7fcdf524-63d3-4eb8-9681-cfff1959844f/column-metadata" : {
        "name" : "ROI metadata",
        "description" : "The table column that contains ROI metadata in as JSON object (string keys, string values). If not valid JSON, the metadata will be stored into a field 'metadata_'.\n\nThis parameter can be used to either select an existing column from a table or to generate a new column by providing a value for each row.<ul><li>Selecting columns by exact name: Type in the name of the column into the value field. Quotation marks are optional.</li><li>Selecting columns by filtering: The value expression is called for each existing column and provided as variable 'value'. Return TRUE at any point to select the value. Example: <code>value == \"Mean\"</code></li><li>Generating columns: The value expression is called for each row. Return a string or number. You have access to the other column values inside the row (as variables). Example: <code>Mean + 0.5 * X</code>. If you do not provide a valid expression, the expression itself is put in as column value (string)</li></ul>"
      },
      "968d4e13-1064-4023-afb4-3619f263c064/jipipe:data-batch-generation/column-matching" : {
        "important" : true,
        "pinned" : true,
        "name" : "Grouping method",
        "description" : "Algorithms with multiple inputs require to match the incoming data to data sets. This allows you to determine how interesting data annotation columns are extracted from the incoming data. Union matches using the union of annotation columns. Intersection intersects the sets of available columns. You can also customize which columns should be included or excluded."
      },
      "2606a48c-c8e7-49e4-9725-bf3493139e56/jipipe:parameter-slot-algorithm/has-parameter-slot" : {
